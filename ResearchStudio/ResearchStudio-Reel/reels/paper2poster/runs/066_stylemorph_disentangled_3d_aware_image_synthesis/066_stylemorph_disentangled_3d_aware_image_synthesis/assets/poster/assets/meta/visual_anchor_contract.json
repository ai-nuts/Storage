          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_stylemorph_3_d_aware_generative_pull",
          "text": "StyleMorph is a 3D-aware generative model that pulls apart the four things that make an image what it is: the object's 3D shape, the camera pose, the object's appearance, and the background.",
          "expected_role": "content",
          "cue_keywords": [
