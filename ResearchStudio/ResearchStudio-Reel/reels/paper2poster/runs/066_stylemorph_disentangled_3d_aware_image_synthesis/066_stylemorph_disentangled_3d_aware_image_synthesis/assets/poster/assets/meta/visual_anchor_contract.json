    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_morphable_models_workhorse_visual_ef",
          "text": "Morphable models are the workhorse of visual effects and augmented reality because they hand creators clean, separate dials for pose, expression, and appearance.",
