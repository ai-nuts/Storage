        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_does_learning_3_morphable_nothing",
          "text": "It does this by learning a 3D morphable model from nothing but ordinary 2D photos, with no 3D scans, no pose labels, and no template supplied by hand.",
          "expected_role": "content",
          "cue_keywords": [
