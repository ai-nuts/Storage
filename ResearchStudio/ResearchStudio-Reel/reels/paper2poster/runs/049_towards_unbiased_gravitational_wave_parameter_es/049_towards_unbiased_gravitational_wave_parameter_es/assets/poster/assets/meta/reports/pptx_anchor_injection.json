      "chunk_index": 2,
      "chunk_id": "s01_c02",
      "text": "This work introduces SLIC, Score-based Likelihood Characterization.",
      "box": [
        0.0625,
        0.4667,
        0.4688,
        0.0722
      ],
      "target_source": "svg"
    },
    {
