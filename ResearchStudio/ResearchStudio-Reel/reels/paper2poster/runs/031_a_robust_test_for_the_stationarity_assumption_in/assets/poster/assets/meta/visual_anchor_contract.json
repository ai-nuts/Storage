        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_introduces_doubly_robust_statistical",
          "text": "This paper introduces a doubly robust statistical test that checks whether an offline Markov decision process is actually stationary, and pinpoints where it changes.",
          "expected_role": "content",
