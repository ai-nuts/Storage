        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_doubly_robust_means_test_controls",
          "text": "Doubly robust means the test controls the type-one error as long as either the transition function or the marginal state-action distribution is correctly specified, so you get valid inference even when one nuisance model is wrong.",
          "expected_role": "method",
          "cue_keywords": [
            "doubly",
            "robust",
            "means",
            "test",
            "controls",
            "type-one",
            "error",
            "long",
            "either",
