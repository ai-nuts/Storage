      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_core_contribution_model_based_doubly",
          "text": "The paper's core contribution is a model-based, doubly robust procedure that tests the stationarity assumption and locates change points in offline reinforcement learning.",
          "expected_role": "content",
          "cue_keywords": [
            "core",
            "contribution",
            "model-based",
            "doubly",
            "robust",
            "procedure",
            "tests",
