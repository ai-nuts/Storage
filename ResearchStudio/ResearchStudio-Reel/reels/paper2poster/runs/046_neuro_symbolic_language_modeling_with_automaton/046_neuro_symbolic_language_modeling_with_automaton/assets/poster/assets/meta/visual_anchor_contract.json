          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_saving_pointers_between_consecutive",
          "text": "By saving pointers between consecutive entries and clustering entries into states, RetoMaton lets the model follow cheap automaton transitions instead of searching from scratch.",
          "expected_role": "content",
          "cue_keywords": [
            "saving",
            "pointers",
            "between",
            "consecutive",
            "entries",
            "clustering",
            "entries",
