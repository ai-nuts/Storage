        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_introduces_retomaton_short_retrieval",
          "text": "This paper introduces RetoMaton, short for retrieval automaton, which builds a weighted finite automaton on top of the datastore.",
          "expected_role": "content",
          "cue_keywords": [
