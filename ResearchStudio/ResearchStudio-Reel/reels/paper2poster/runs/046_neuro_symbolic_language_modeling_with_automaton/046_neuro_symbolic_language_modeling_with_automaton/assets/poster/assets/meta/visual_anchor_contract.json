          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_retrieved_entry_useful_now_entry",
          "text": "If a retrieved entry was useful now, the entry that follows it in the original text is very likely useful next.",
