          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_second_clusters_entries_similar_key",
          "text": "Second, it clusters entries with similar key vectors into states, and those states share their outgoing pointers.",
          "expected_role": "content",
          "cue_keywords": [
            "second",
            "clusters",
            "entries",
            "similar",
            "key",
