        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_result_eighty_three_percent_fewer_ne",
          "text": "The result: up to eighty-three percent fewer nearest-neighbor searches with no loss in perplexity, or up to one point eight five lower perplexity when the search budget is kept.",
          "expected_role": "result",
          "cue_keywords": [
