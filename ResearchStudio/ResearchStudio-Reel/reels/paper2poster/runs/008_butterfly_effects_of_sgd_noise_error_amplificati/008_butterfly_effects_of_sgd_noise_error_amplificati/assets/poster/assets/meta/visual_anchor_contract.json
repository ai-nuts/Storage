    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_modern_deep_learning_full_feedback",
          "text": "Modern deep learning is full of feedback loops. A language model's next token depends on the tokens it already generated. A robot's next observation depends on the action it just took.",
          "expected_role": "content",
          "cue_keywords": [
            "modern",
            "deep",
            "learning",
            "full",
            "feedback",
            "loops",
            "language",
            "next",
            "token",
            "depends"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_but_when_train_these_systems",
          "text": "But when we train these systems, we almost always optimize a surrogate objective, like next-token prediction, that pretends the feedback loop is not there.",
          "expected_role": "content",
          "cue_keywords": [
            "but",
            "when",
            "train",
            "these",
            "systems",
