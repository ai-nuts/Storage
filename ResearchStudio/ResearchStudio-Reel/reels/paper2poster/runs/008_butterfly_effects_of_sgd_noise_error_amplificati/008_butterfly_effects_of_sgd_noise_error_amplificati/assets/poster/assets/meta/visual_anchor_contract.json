      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_makes_three_main_contributions",
          "text": "The paper makes three main contributions.",
          "expected_role": "content",
