            "instability",
            "behavior",
            "cloning"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_when_you_train_policy_network",
          "text": "When you train a policy network with minibatch stochastic gradient descent, the long-horizon reward can swing wildly from one iterate to the next, even though the behavior cloning loss barely moves.",
          "expected_role": "figure",
          "cue_keywords": [
            "when",
            "you",
            "train",
            "policy",
            "network",
            "minibatch",
            "stochastic",
            "gradient",
            "descent",
            "long-horizon"
