        {
          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_studies_puzzling_instability_behavio",
          "text": "This paper studies a puzzling training instability in behavior cloning.",
          "expected_role": "method",
          "cue_keywords": [
