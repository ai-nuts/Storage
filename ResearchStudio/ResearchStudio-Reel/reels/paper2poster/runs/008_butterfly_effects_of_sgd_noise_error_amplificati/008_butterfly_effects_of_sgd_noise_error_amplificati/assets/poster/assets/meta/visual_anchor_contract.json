        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_surrogate_tends_improve_smoothly_whi",
          "text": "That surrogate tends to improve smoothly, which lulls us into thinking training is well behaved.",
          "expected_role": "method",
          "cue_keywords": [
