        },
        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_second_shows_problem_algorithmic_rat",
          "text": "Second, it shows the problem is algorithmic rather than statistical, and that an exponential moving average of the weights fixes it, even though most standard mitigations fail.",
          "expected_role": "result",
          "cue_keywords": [
            "second",
            "shows",
            "problem",
            "algorithmic",
            "rather",
            "statistical",
            "exponential",
            "moving",
            "average",
