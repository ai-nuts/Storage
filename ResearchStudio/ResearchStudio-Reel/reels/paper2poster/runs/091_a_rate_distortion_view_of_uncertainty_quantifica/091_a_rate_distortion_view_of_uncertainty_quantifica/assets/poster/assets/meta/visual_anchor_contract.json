        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_deep_neural_networks_however_often",
          "text": "Deep neural networks, however, often make confident predictions even on inputs that are wildly different from their training data.",
          "expected_role": "method",
          "cue_keywords": [
            "deep",
            "neural",
            "networks",
            "however",
