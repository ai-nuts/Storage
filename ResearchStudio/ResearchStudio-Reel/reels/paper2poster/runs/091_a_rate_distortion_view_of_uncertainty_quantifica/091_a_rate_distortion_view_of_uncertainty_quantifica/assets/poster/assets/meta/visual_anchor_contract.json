      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_their_key_idea_view_uncertainty",
          "text": "Their key idea is to view uncertainty quantification through the lens of rate-distortion theory.",
