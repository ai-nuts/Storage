        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_classical_probabilistic_models_such",
          "text": "Classical probabilistic models such as Gaussian Processes have a built-in sense of distance from the training set, but standard deep networks do not, and reliable, efficient uncertainty estimation for real deployments remains an open problem.",
          "expected_role": "method",
          "cue_keywords": [
            "classical",
            "probabilistic",
            "models",
            "such",
            "gaussian",
