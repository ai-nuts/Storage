        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_cross_attention_backbone_positional",
          "text": "A cross attention backbone with positional encoding then lets source and target descriptors exchange information, which is what enables the network to hallucinate peaked distributions for occluded and out of frame points.",
          "expected_role": "method",
          "cue_keywords": [
            "cross",
            "attention",
            "backbone",
