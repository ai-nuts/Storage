      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_how_neurhal_works_siamese_convolutio",
          "text": "Here is how NeurHal works. A siamese convolutional backbone turns both images into dense descriptor maps. To allow correspondents outside the target's field of view, the target map is padded with a learnable vector, initializing descriptors beyond the image borders.",
          "expected_role": "content",
          "cue_keywords": [
