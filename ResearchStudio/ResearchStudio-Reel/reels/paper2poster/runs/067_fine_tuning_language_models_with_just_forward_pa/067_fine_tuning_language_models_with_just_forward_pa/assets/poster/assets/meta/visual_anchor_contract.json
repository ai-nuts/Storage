    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_makes_four_main_contributions_first",
          "text": "The paper makes four main contributions. First, it introduces MeZO, a memory-efficient zeroth-order optimizer that adapts classical zeroth-order SGD to operate in place, so fine-tuning costs no more memory than inference.",
          "expected_role": "content",
          "cue_keywords": [
            "makes",
            "four",
            "main",
            "contributions",
            "first",
            "introduces",
            "mezo",
            "memory-efficient",
            "zeroth-order",
            "optimizer"
