    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_zeroth_order_optimization_offers_tem",
          "text": "Zeroth-order optimization offers a tempting escape: it can estimate a gradient using only two forward passes, requiring no backpropagation at all.",
          "expected_role": "content",
          "cue_keywords": [
            "zeroth-order",
            "optimization",
