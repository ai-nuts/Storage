  "editTargets": {
    "key-result": "<div class=\"section grow\" data-section=\"key-result\">\n        <h2>Key Results <button class=\"listen-btn\" data-section=\"key-result\">Listen</button></h2>\n        <ul>\n          <li><strong>Better-calibrated CIs</strong> than popular single-model UQ methods across size, concept, and covariate shifts \u2014 accuracy maintained or improved.</li>\n          <li><strong>Downstream wins.</strong> Lowest-MAE single-model estimator for generalization-gap prediction; the pretrained variant is often strongest, notably under covariate shift.</li>\n        </ul>\n        <figure><img src=\"assets/figures/figure4.png\" alt=\"\"><figcaption>Fig 4 \u2014 Size shift (D&amp;D \u00b7 NCI1 \u00b7 NCI109 \u00b7 PROTEINS; GCN/GIN/PNA): G-\u2206UQ (blue) lowers ECE while maintaining or improving accuracy vs Base.</figcaption></figure>\n        <p class=\"conclusion\">Reliable confidence estimates yield concrete gains on the safety tasks that use them.</p>\n      </div>",
    "headline-numbers": "<div class=\"section\" data-section=\"headline-numbers\">\n        <h2>Headline Numbers</h2>\n        <!-- Hero + supporting. 3\u00d73 = signature number; shift regimes \u00d7 safety tasks = what it measures;\n             covered by one single-model method = italic punchline. \u22652 supporting .stat-mini tiles. Drop unused tiles if <4\n             numbers. Never invent \u2014 every value must trace to text.txt. -->\n        <div class=\"headline-hero\">\n          <div class=\"hero-main\"><div class=\"hero-val\" style=\"font-size:1.14em\">3\u00d73</div>\n          <div class=\"hero-label\">shift regimes \u00d7 safety tasks</div>\n          <div class=\"hero-note\">covered by a single model \u2014 no ensembles, no extra passes</div></div>\n          <div class=\"supporting\">\n            <div class=\"stat-mini\"><div class=\"val\">4</div><div class=\"lbl\">UQ baselines</div></div>\n            <div class=\"stat-mini\"><div class=\"val\">4</div><div class=\"lbl\">anchoring variants</div></div>\n            <div class=\"stat-mini\"><div class=\"val\">3</div><div class=\"lbl\">GNN backbones</div></div>\n            <div class=\"stat-mini\"><div class=\"val\">0</div><div class=\"lbl\">extra models</div></div>\n          </div>\n        </div>\n      </div>",
    "takeaway": "<div class=\"section\" data-section=\"takeaway\">\n        <h2>Takeaway <button class=\"listen-btn\" data-section=\"takeaway\">Listen</button></h2>\n        <div class=\"p-callout-primary\" style=\"padding-top:0.85em;padding-bottom:0.85em\">More expressive GNNs don't fix calibration under shift. Extending stochastic centering to graphs with partial stochasticity (G-\u2206UQ) is a scalable, single-model route to reliable, well-calibrated uncertainty \u2014 cheap to add to pretrained models.</div>\n      </div>"
  }
