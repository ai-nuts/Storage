    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_method_builds_picard_iterations_clas",
          "text": "The method builds on Picard iterations, a classic technique for solving ordinary differential equations by fixed-point iteration. The insight is to write the value at each timestep as the initial value plus the integral of the drift along the path.",
          "expected_role": "method",
          "cue_keywords": [
            "method",
            "builds",
            "picard",
            "iterations",
            "classic",
            "technique",
            "solving",
            "ordinary",
            "differential",
            "equations"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_starting_full_guess_trajectory_parad",
          "text": "Starting from a full guess of the trajectory, ParaDiGMS updates every timestep simultaneously using the cumulative drift, and repeats until the values stop changing.",
          "expected_role": "method",
          "cue_keywords": [
            "starting",
            "full",
            "guess",
            "trajectory",
            "paradigms",
            "updates",
            "every",
            "timestep",
            "simultaneously",
            "cumulative"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_because_iteration_computed_parallel",
          "text": "Because each iteration can be computed in parallel across timesteps, and the number of iterations to converge is much smaller than the number of steps, the whole trajectory resolves much faster.",
          "expected_role": "figure",
          "cue_keywords": [
            "because",
            "iteration",
            "computed",
            "parallel",
            "across",
            "timesteps",
            "number",
            "iterations",
            "converge",
            "much"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_practice_sliding_window_fixed_size",
          "text": "In practice it uses a sliding window of a fixed size to respect GPU memory, advancing the window as soon as the earliest timesteps converge.",
          "expected_role": "content",
          "cue_keywords": [
            "practice",
            "sliding",
            "window",
            "fixed",
            "size",
            "respect",
            "gpu",
            "memory",
