    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_key_contribution_paradigms_short_par",
          "text": "The key contribution is ParaDiGMS, short for Parallel Diffusion Generative Model Sampling.",
