        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_goal_lower_latency_generating_single",
          "text": "The goal is to lower the latency of generating a single sample, not just the throughput of generating many.",
