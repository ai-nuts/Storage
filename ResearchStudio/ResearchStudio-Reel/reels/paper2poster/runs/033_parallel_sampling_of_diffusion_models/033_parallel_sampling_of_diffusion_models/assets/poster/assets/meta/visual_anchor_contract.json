        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_instead_cutting_number_steps_paying",
          "text": "Instead of cutting the number of steps and paying with sample quality, can we keep every step but run them in parallel, trading extra compute for lower latency?",
          "expected_role": "content",
          "cue_keywords": [
