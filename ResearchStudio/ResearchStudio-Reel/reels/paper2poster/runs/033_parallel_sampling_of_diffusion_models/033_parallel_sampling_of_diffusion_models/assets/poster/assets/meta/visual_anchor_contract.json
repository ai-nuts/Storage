        },
        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_answer_method_called_paradigms_which",
          "text": "The answer is a method called ParaDiGMS, which uses Picard iterations to guess the whole denoising trajectory and refine it in parallel until it converges.",
          "expected_role": "method",
          "cue_keywords": [
