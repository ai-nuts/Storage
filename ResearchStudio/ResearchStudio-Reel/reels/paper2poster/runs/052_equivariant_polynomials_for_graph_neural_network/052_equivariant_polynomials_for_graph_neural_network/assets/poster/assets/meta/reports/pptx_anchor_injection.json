      "slide_index": 4,
      "anchor_id": "cue_s04_c1_core_object_basis_equivariant_graph",
      "chunk_index": 1,
      "chunk_id": "s04_c01",
      "text": "The core object is a basis for equivariant graph polynomials. Each basis element is a directed multi-graph with a marked red edge, and its value is a tensor contraction, an einsum over adjacency entries that sums over internal nodes.",
      "box": [
        0.05,
        0.2083,
        0.3531,
        0.7028
      ],
      "target_source": "svg"
    },
