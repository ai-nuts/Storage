      "anchor_id": "cue_s04_c3_analyze_network_authors_treat_bank",
      "chunk_index": 3,
      "chunk_id": "s04_c03",
      "text": "To analyze a network, the authors treat it as a bank of primitive contractions and give a linear-time algorithm deciding which polynomials it can assemble.",
      "box": [
        0.4219,
        0.4417,
        0.5281,
        0.2111
      ],
      "target_source": "svg"
