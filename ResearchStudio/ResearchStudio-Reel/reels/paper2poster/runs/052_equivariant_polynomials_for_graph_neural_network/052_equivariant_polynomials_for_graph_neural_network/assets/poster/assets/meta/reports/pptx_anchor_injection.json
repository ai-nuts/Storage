      "anchor_id": "cue_s04_c2_averaging_monomials_over_all_node",
      "chunk_index": 2,
      "chunk_id": "s04_c02",
      "text": "Averaging monomials over all node permutations, the Reynolds operator, makes them equivariant.",
      "box": [
        0.4219,
        0.2083,
        0.5281,
        0.2111
      ],
      "target_source": "svg"
    },
    {
