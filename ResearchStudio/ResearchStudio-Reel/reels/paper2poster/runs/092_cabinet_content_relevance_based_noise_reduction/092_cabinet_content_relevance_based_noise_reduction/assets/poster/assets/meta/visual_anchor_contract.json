    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_contributes_cabinet_short_content_re",
          "text": "The paper contributes CABINET, short for Content Relevance-Based Noise Reduction. It has two cooperating parts.",
          "expected_role": "content",
          "cue_keywords": [
            "contributes",
            "cabinet",
            "short",
            "content",
            "relevance-based",
            "noise",
            "reduction",
            "two",
            "cooperating",
