    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_natural_way_reduce_noise_shrink",
          "text": "A natural way to reduce noise is to shrink the table before answering, and methods like DATER do this by decomposing the table into a smaller sub-table.",
          "expected_role": "method",
          "cue_keywords": [
            "natural",
            "way",
            "reduce",
            "noise",
            "shrink",
            "table",
            "before",
            "answering",
            "methods",
            "like"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_trouble_hard_decomposition_unforgivi",
          "text": "The trouble is that hard decomposition is unforgiving: if the wrong sub-table is extracted, useful information is permanently lost and the reasoner answers incorrectly with no way to recover.",
          "expected_role": "title",
          "cue_keywords": [
            "trouble",
            "hard",
            "decomposition",
            "unforgiving",
            "wrong",
            "sub-table",
            "extracted",
            "useful",
            "information",
            "permanently"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_cabinet_argues_softer_approach_weigh",
          "text": "CABINET argues for a softer approach that weighs relevant parts higher without ever explicitly removing content, so the answering model retains access to the whole table while being steered toward what matters.",
          "expected_role": "title",
          "cue_keywords": [
            "cabinet",
            "argues",
            "softer",
            "approach",
            "weighs",
            "relevant",
            "parts",
            "higher",
            "without",
            "ever"
          ],
