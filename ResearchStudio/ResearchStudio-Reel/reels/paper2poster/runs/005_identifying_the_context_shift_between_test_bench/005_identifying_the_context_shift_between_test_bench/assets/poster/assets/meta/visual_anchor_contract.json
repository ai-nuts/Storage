    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_context_refers_semantically_meaningf",
          "text": "Context refers to the semantically meaningful upstream factors that drive a distribution shift.",
