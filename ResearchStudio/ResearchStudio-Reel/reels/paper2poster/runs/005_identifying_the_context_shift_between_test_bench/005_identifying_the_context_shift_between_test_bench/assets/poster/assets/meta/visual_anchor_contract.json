      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_perspective_reframes_robustness_prob",
          "text": "This is a perspective paper that reframes the robustness problem.",
