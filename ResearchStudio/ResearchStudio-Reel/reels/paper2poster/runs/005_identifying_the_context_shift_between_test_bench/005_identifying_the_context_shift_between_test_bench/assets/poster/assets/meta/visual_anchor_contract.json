      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_benchmark_datasets_play_two_roles",
          "text": "Benchmark datasets play two roles: they let researchers compare methods, and they stand in as an imperfect model of the real world. The trouble is that a single static benchmark can never fully capture the dynamic, high-dimensional complexity of real tasks.",
          "expected_role": "method",
          "cue_keywords": [
            "benchmark",
            "datasets",
            "play",
            "two",
            "roles",
            "they",
            "let",
            "researchers",
            "compare",
            "methods"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_models_appear_match_beat_human_level",
          "text": "So models that appear to match or beat human-level accuracy on a benchmark routinely err on out-of-distribution and adversarially perturbed production data.",
          "expected_role": "method",
          "cue_keywords": [
            "models",
            "appear",
