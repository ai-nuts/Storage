        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_dartformer_builds_single_layer_super",
          "text": "DARTFormer builds a single-layer supernetwork that holds one candidate block for every efficient attention type in parallel.",
