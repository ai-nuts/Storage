    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_key_insight_images_highly_redundant",
          "text": "The key insight is that images are highly redundant. Patches repeat, textures recur, and similar structures appear across many images.",
          "expected_role": "method",
          "cue_keywords": [
            "key",
            "insight",
            "images",
            "highly",
            "redundant",
            "patches",
            "repeat",
            "textures",
            "recur",
            "similar"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_classical_representation_learning_di",
          "text": "Classical representation learning, dictionary learning and sparse coding, was built exactly to capture this: represent many signals as sparse combinations of a shared dictionary.",
          "expected_role": "content",
          "cue_keywords": [
            "classical",
            "representation",
            "learning",
            "dictionary",
            "learning",
            "sparse",
            "coding",
            "built",
            "exactly",
            "capture"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_handful_recent_distillation_methods",
          "text": "A handful of recent distillation methods started exploiting relationships between synthetic images, but none tackled redundancy in a spatially-agnostic way, no matter where a feature appears.",
          "expected_role": "method",
          "cue_keywords": [
            "handful",
            "recent",
            "distillation",
            "methods",
            "started",
            "exploiting",
            "relationships",
