    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_goal_dataset_distillation_shrink_big",
          "text": "The goal of dataset distillation is to shrink a big dataset into a small synthetic set that still trains models well.",
          "expected_role": "content",
          "cue_keywords": [
            "goal",
            "dataset",
            "distillation",
            "shrink",
            "big",
            "dataset",
            "small",
            "synthetic",
            "set",
            "still"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_most_existing_work_pours_its",
          "text": "Most existing work pours its energy into the matching objective, the loss that aligns the synthetic and real datasets. But how the synthetic images are actually parameterized has been an afterthought.",
          "expected_role": "figure",
          "cue_keywords": [
            "most",
            "existing",
            "work",
            "pours",
            "its",
            "energy",
            "matching",
            "objective",
            "loss",
            "aligns"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_standard_approach_optimizes_syntheti",
          "text": "The standard approach optimizes each synthetic image independently, a naive scheme that never exploits the fact that natural images share enormous amounts of visual structure, both within a single image and across different images.",
          "expected_role": "method",
          "cue_keywords": [
            "standard",
            "approach",
            "optimizes",
            "synthetic",
            "image",
            "independently",
            "naive",
            "scheme",
            "never",
            "exploits"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_spatial_redundancy_silently_wastes_a",
          "text": "This spatial redundancy silently wastes the already tiny storage budget, and the problem gets worse as image resolution grows.",
          "expected_role": "content",
          "cue_keywords": [
            "spatial",
            "redundancy",
            "silently",
            "wastes",
            "already",
            "tiny",
            "storage",
