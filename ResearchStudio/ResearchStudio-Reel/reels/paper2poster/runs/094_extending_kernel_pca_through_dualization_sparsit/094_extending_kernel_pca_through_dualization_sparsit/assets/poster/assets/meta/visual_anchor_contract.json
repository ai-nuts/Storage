      "id": "key-result",
      "heading": "Key Result",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s07_c01",
          "anchor_id": "cue_s07_c1_efficiency_benchmarks_proposed_solve",
          "text": "On the efficiency benchmarks, the proposed solver wins across the board.",
          "expected_role": "result",
