    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_authors_observe_kernel_pca_written",
          "text": "The authors observe that Kernel PCA can be written as variance maximization under orthonormality constraints, which puts it squarely in the family of difference-of-convex problems that optimization researchers understand well.",
          "expected_role": "method",
          "cue_keywords": [
            "authors",
            "observe",
            "kernel",
            "pca",
            "written",
            "variance",
            "maximization",
            "under",
            "orthonormality",
            "constraints"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_earlier_work_had_studied_pca",
          "text": "Earlier work had studied PCA as a difference-of-convex program, but only for linear PCA, and often only for the first component where the orthogonality constraints vanish.",
          "expected_role": "method",
          "cue_keywords": [
            "earlier",
            "work",
            "had",
            "studied",
            "pca",
            "difference-of-convex",
            "program",
            "but",
            "only",
            "linear"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_meanwhile_separate_line_research_had",
          "text": "Meanwhile, a separate line of research had shown that infimal convolution is an elegant way to build robust or sparse losses, and that these constructions behave especially nicely in dual formulations.",
          "expected_role": "method",
          "cue_keywords": [
            "meanwhile",
            "separate",
            "line",
            "research",
            "had",
            "shown",
            "infimal",
            "convolution",
            "elegant",
            "way"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s03_c04",
          "anchor_id": "cue_s03_c4_bringing_these_two_observations_toge",
          "text": "Bringing these two observations together is the opening the paper exploits.",
          "expected_role": "content",
          "cue_keywords": [
            "bringing",
            "these",
            "two",
            "observations",
            "together",
            "opening",
            "exploits"
          ],
          "required": true
        }
      ]
