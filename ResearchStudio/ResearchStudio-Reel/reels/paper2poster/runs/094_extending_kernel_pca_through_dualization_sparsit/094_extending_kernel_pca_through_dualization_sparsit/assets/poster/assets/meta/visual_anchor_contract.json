        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_authors_reformulate_kernel_pca_diffe",
          "text": "The authors reformulate Kernel PCA as a difference of convex functions problem, then dualize it.",
          "expected_role": "content",
          "cue_keywords": [
            "authors",
            "reformulate",
            "kernel",
            "pca",
            "difference",
            "convex",
            "functions",
            "problem",
            "dualize"
