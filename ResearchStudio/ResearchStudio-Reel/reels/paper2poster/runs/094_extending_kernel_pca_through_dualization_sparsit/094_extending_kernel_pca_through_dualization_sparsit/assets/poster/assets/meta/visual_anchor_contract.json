        },
        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_single_move_unlocks_three_things",
          "text": "This single move unlocks three things at once: gradient-based solvers that avoid the expensive cubic singular value decomposition of the Gram matrix, a flexible framework that swaps in robust or sparse objectives through Moreau envelopes, and significant speedups on real benchmarks.",
          "expected_role": "result",
          "cue_keywords": [
            "single",
            "move",
            "unlocks",
            "three",
            "things",
            "once",
            "gradient-based",
            "solvers",
            "avoid",
            "expensive"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_clean_example_how_right_optimization",
          "text": "It is a clean example of how the right optimization viewpoint can extend a classical method in several directions simultaneously.",
          "expected_role": "method",
          "cue_keywords": [
            "clean",
            "example",
            "how",
            "right",
