          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_result_value_function_free_approach",
          "text": "The result is a value-function-free approach that reaches goals from arbitrary starting states, needs only a single denoising step per environment step, and runs an order of magnitude faster than other diffusion-based reinforcement learning methods.",
          "expected_role": "method",
          "cue_keywords": [
            "result",
            "value-function-free",
            "approach",
            "reaches",
            "goals",
            "arbitrary",
            "starting",
            "states",
            "needs",
            "only"
          ],
          "required": true
        }
      ]
    },
    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_goal_conditioned_reinforcement_learn",
          "text": "Goal-conditioned reinforcement learning aims to train a single agent that can reach any target state within an environment, using only a sparse reward of one when the goal is reached and zero otherwise.",
          "expected_role": "content",
          "cue_keywords": [
            "goal-conditioned",
            "reinforcement",
            "learning",
            "aims",
            "train",
