    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_how_merlin_works_take_trajectory",
          "text": "Here is how Merlin works. Take a trajectory from the offline dataset and read it backwards, starting from its final goal state.",
          "expected_role": "figure",
          "cue_keywords": [
            "how",
            "merlin",
            "works",
            "take",
            "trajectory",
            "offline",
            "dataset",
            "read",
            "backwards",
