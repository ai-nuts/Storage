        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_trouble_most_methods_rely_estimating",
          "text": "The trouble is that most methods rely on estimating a value function, and in the offline goal-conditioned setting this estimate is fragile.",
          "expected_role": "method",
          "cue_keywords": [
            "trouble",
            "most",
            "methods",
            "rely",
            "estimating",
            "value",
            "function",
