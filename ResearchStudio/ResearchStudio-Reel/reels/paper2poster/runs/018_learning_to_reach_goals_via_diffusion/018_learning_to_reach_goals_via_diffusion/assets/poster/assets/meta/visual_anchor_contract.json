          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_offline_setting_agent_must_learn",
          "text": "In the offline setting, the agent must learn purely from a pre-collected dataset, without any further interaction.",
          "expected_role": "content",
          "cue_keywords": [
            "offline",
