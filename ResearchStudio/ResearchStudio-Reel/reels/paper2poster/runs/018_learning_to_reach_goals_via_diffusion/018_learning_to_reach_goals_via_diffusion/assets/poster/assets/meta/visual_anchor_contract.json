          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_their_method_called_merlin_builds",
          "text": "Their method, called Merlin, builds trajectories that drift away from goal states and then trains a policy to reverse that drift, exactly as a diffusion model denoises noise back into data.",
          "expected_role": "method",
          "cue_keywords": [
            "their",
            "method",
            "called",
            "merlin",
            "builds",
            "trajectories",
            "drift",
            "away",
            "goal",
            "states"
