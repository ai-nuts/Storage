        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_given_offline_dataset_trajectories_a",
          "text": "Given an offline dataset of trajectories, it applies hindsight relabeling: every observed action becomes a demonstration for whatever outcome actually occurred later in that same trajectory.",
          "expected_role": "method",
          "cue_keywords": [
