    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_method_deliberately_simple_rvs_assum",
          "text": "The method is deliberately simple. RvS assumes an agent in a Markov decision process and trains a policy conditioned on an outcome, which can be either a future goal state or an average future return.",
          "expected_role": "method",
          "cue_keywords": [
            "method",
