        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_two_things_really_matter_they",
          "text": "The two things that really matter, they show, are choosing the model's capacity carefully and choosing what to condition on, goals or rewards. Everything else turns out to be optional.",
          "expected_role": "content",
          "cue_keywords": [
            "two",
