        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_linking_layer_injects_column_vector",
          "text": "A linking layer injects the column vector into each value token, so attention links values to their column. All cell vectors, plus a CLS token, pass through a Transformer encoder.",
          "expected_role": "method",
          "cue_keywords": [
