          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_name_embedded_mean_pooled_data_type",
          "text": "The name is embedded and mean-pooled, and a data-type embedding, marking numerical, categorical, or textual, is fused in through a gate, so a salary column is handled whether its values are numbers or words.",
          "expected_role": "method",
          "cue_keywords": [
            "name",
            "embedded",
            "mean-pooled",
            "data-type",
            "embedding",
            "marking",
