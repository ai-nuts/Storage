      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_unitabe_heart_module_called_tabunit",
          "text": "At UniTabE's heart is a module called TabUnit that handles one cell at a time. It treats each cell as a key-value pair: the column name is the key, the content the value.",
          "expected_role": "content",
          "cue_keywords": [
