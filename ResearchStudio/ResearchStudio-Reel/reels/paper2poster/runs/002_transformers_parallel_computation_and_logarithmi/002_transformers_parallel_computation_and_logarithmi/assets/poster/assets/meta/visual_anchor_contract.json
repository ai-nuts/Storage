      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_authors_insight_self_attention_funda",
          "text": "The authors' insight is that self-attention is fundamentally a parallel operation.",
