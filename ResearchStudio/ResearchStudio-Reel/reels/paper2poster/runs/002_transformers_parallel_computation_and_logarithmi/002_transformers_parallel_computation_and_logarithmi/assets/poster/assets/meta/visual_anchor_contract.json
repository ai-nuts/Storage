      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_makes_two_main_contributions_first",
          "text": "The paper makes two main contributions. First, it establishes a tight correspondence: any R-round MPC protocol can be run by a transformer of depth about R, and conversely any depth-L transformer can be simulated by an O(L)-round MPC protocol.",
          "expected_role": "method",
          "cue_keywords": [
