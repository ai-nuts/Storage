    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_core_idea_raise_network_degrees",
          "text": "The core idea is to raise the network's degrees of freedom without adding new parameters, by letting existing components do more work, as biology does.",
          "expected_role": "content",
          "cue_keywords": [
            "core",
            "idea",
            "raise",
            "network",
