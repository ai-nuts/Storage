    {
      "index": 10,
      "id": "takeaway",
      "heading": "Takeaway",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s10_c01",
          "anchor_id": "cue_s10_c1_one_line_takeaway_represent_whole_po",
          "text": "\"The one-line takeaway: represent the whole population in a single conditional model, let the interaction graph decide who trains against whom, and skills transfer for free across policies.",
          "expected_role": "result",
          "cue_keywords": [
            "one-line",
            "takeaway",
            "represent",
            "whole",
            "population",
            "single",
