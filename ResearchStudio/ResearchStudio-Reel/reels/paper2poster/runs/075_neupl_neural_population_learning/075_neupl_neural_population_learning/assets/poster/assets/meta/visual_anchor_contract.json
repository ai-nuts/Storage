      "heading": "Ablation Study",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s08_c01",
          "anchor_id": "cue_s08_c1_key_ablation_isolates_role_transfer",
          "text": "\"A key ablation isolates the role of transfer. NeuPL agents are re-initialized either from scratch or by transferring the encoder and memory components of a network trained to epoch one thousand, then tasked with beating fixed Nash mixtures of increasing strength.",
          "expected_role": "method",
          "cue_keywords": [
