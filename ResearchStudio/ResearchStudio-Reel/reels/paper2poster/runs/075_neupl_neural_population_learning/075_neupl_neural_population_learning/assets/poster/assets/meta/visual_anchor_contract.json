    {
      "index": 7,
      "id": "key-result",
      "heading": "Key Result",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s07_c01",
          "anchor_id": "cue_s07_c1_headline_result_neupl_both_more",
          "text": "\"The headline result is that NeuPL is both more efficient and more robust than comparable PSRO baselines.",
          "expected_role": "result",
          "cue_keywords": [
