        {
          "chunk_index": 2,
          "chunk_id": "s08_c02",
          "anchor_id": "cue_s08_c2_against_easily_exploitable_two_polic",
          "text": "Against an easily exploitable two-policy mixture, even the from-scratch agent eventually finds a counter, just more slowly.",
          "expected_role": "result",
