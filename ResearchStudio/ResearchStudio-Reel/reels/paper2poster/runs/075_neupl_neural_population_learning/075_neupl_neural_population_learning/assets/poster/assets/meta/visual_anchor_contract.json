        {
          "chunk_index": 2,
          "chunk_id": "s07_c02",
          "anchor_id": "cue_s07_c2_maximum_population_eight_policies_ne",
          "text": "With a maximum population of eight policies, a NeuPL population successfully exploits PSRO populations of the same eight policies — even when each PSRO iteration was given twice as many gradient steps.",
          "expected_role": "content",
          "cue_keywords": [
            "maximum",
