          "chunk_id": "s07_c04",
          "anchor_id": "cue_s07_c4_both_continued_training_from_scratch",
          "text": "Both continued-training and from-scratch PSRO variants prove equally exploitable, suggesting they fail to build reusable representations.\"",
          "expected_role": "method",
          "cue_keywords": [
