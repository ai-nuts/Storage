          "chunk_id": "s06_c02",
          "anchor_id": "cue_s06_c2_rock_paper_scissors_classic_purely_c",
          "text": "Rock-paper-scissors is the classic purely cyclic normal-form game, where the learned population can be visualized directly on the strategy simplex.",
          "expected_role": "method",
          "cue_keywords": [
