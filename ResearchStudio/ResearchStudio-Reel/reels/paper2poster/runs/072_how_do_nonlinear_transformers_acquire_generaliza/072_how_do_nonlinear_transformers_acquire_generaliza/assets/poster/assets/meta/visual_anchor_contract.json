      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_deliberately_minimal_but_nonlinear_o",
          "text": "The model is deliberately minimal but nonlinear: one self-attention head with a softmax, followed by a two-layer perceptron with ReLU activation.",
          "expected_role": "method",
          "cue_keywords": [
            "deliberately",
            "minimal",
