        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_in_context_learning_lets_pretrained",
          "text": "In-context learning lets a pretrained Transformer handle new tasks by simply padding the query with a handful of example input-output pairs, no fine-tuning required.",
          "expected_role": "method",
          "cue_keywords": [
