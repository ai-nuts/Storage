        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_classic_remedy_color_invariance_side",
          "text": "The classic remedy, color invariance, sidesteps the problem by removing color entirely, but that throws away a genuinely useful signal.",
          "expected_role": "content",
          "cue_keywords": [
