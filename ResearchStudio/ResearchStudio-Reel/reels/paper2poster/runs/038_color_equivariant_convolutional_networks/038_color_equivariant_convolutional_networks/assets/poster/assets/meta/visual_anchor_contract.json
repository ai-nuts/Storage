      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_group_equivariant_convolutions_taugh",
          "text": "Group equivariant convolutions taught networks to share parameters across rotations and flips, dramatically improving data efficiency for geometric transformations.",
