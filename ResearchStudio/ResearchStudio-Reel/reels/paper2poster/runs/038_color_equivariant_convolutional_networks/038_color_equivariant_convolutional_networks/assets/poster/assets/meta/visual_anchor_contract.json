        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_when_trained_mostly_red_cars",
          "text": "When a model trained mostly on red cars sees a blue one, accuracy collapses.",
          "expected_role": "method",
          "cue_keywords": [
            "when",
            "trained",
            "mostly",
            "red",
            "cars",
            "sees",
