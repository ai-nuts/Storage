    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_hue_shift_hsv_space_becomes",
          "text": "A hue shift in HSV space becomes, in RGB space, a rotation around the gray diagonal from black to white. The authors formalize this as the group H-n of n discrete rotations about that diagonal, a subgroup of all three-dimensional rotations.",
          "expected_role": "content",
          "cue_keywords": [
            "hue",
            "shift",
            "hsv",
            "space",
            "becomes",
            "rgb",
            "space",
            "rotation",
            "around",
            "gray"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_color_equivariant_convolution_correl",
          "text": "A Color Equivariant Convolution correlates the input with hue-rotated copies of each filter, producing feature maps that carry an extra dimension indexing the hue rotation.",
          "expected_role": "content",
          "cue_keywords": [
            "color",
            "equivariant",
            "convolution",
            "correlates",
            "input",
            "hue-rotated",
            "copies",
            "filter",
            "producing",
            "feature"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_hidden_layers_filters_cyclically_per",
          "text": "In hidden layers, filters are cyclically permuted across this dimension so equivariance is preserved throughout the network.",
          "expected_role": "guidance",
          "cue_keywords": [
            "hidden",
            "layers",
            "filters",
            "cyclically",
            "permuted",
            "across",
            "dimension",
            "equivariance",
            "preserved",
            "throughout"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_because_extra_dimension_multiplies_n",
          "text": "Because the extra dimension multiplies the number of feature maps, the authors decompose filters into spatial and pointwise components and offer hybrid variants that use color equivariance only in the early, most color-selective stages, keeping parameter and compute cost in check.",
          "expected_role": "method",
          "cue_keywords": [
            "because",
            "extra",
            "dimension",
            "multiplies",
            "number",
            "feature",
