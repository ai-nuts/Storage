        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_shares_shape_information_across_colo",
          "text": "It shares shape information across the color spectrum while keeping color in a dedicated group dimension of the feature map.",
