        {
          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_color_powerful_cue_convolutional_net",
          "text": "Color is a powerful cue that convolutional networks readily exploit for object recognition, but it becomes a liability when the colors seen at test time differ from those in training.",
          "expected_role": "method",
          "cue_keywords": [
            "color",
            "powerful",
            "cue",
            "convolutional",
            "networks",
            "readily",
            "exploit",
            "object",
            "recognition",
            "but"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_introduces_color_equivariant_convolu",
          "text": "This paper introduces Color Equivariant Convolutions, or CEConvs, a new building block that shares shape features across the color spectrum while preserving discriminative color information.",
          "expected_role": "figure",
          "cue_keywords": [
            "introduces",
            "color",
            "equivariant",
            "convolutions",
            "ceconvs",
            "new",
            "building",
            "block",
            "shares",
            "shape"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_hard_wiring_parameter_sharing_over_d",
          "text": "By hard-wiring parameter sharing over discrete hue shifts, CEConvs let networks like ResNets generalize to underrepresented colors and stay robust to test-time hue shifts, without throwing color away.",
          "expected_role": "content",
          "cue_keywords": [
            "hard-wiring",
            "parameter",
            "sharing",
            "over",
            "discrete",
            "hue",
            "shifts",
            "ceconvs",
            "let",
            "networks"
          ],
          "required": true
        }
      ]
    },
    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_convolutional_neural_networks_lean_h",
          "text": "Convolutional neural networks lean heavily on color to recognize objects, but real-world data rarely contains every color a class can take.",
          "expected_role": "content",
          "cue_keywords": [
            "convolutional",
            "neural",
            "networks",
            "lean",
            "heavily",
            "color",
            "recognize",
