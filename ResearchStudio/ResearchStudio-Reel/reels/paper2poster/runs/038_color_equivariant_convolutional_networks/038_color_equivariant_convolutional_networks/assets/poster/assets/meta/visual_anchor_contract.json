        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_because_formulated_language_symmetry",
          "text": "Because it is formulated in the language of symmetry groups, it slots directly into standard networks like ResNet with no architectural surgery.",
          "expected_role": "content",
          "cue_keywords": [
            "because",
            "formulated",
            "language",
            "symmetry",
            "groups",
