      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_core_contribution_color_equivariant",
          "text": "The core contribution is the Color Equivariant Convolution, a new layer that hard-wires parameter sharing over hue shifts.",
