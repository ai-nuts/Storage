          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_frames_real_challenge_keeping_color",
          "text": "The paper frames the real challenge as keeping color information while still generalizing across colors that were rare or absent during training.",
          "expected_role": "method",
          "cue_keywords": [
