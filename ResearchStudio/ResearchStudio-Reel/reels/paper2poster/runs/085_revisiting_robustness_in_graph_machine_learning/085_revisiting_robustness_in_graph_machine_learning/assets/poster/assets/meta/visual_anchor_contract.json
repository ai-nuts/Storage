          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_iclr_2023_technical_university_munic",
          "text": "This ICLR 2023 paper from the Technical University of Munich asks a sharper question: do those small perturbations actually preserve a node's true meaning?",
          "expected_role": "title",
          "cue_keywords": [
            "iclr",
            "2023",
            "technical",
            "university",
            "munich",
            "asks",
            "sharper",
