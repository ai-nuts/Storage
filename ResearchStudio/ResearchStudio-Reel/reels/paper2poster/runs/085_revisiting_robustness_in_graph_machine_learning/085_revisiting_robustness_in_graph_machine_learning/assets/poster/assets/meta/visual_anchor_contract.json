      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_belief_graph_neural_networks_easily",
          "text": "The belief that graph neural networks are easily fooled rests on the assumption that the perturbations used are semantics-preserving.",
