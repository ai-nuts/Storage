          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_graph_neural_networks_famously_easy",
          "text": "Graph neural networks are famously easy to fool with small structural changes, and the field has long treated that fragility as pure adversarial vulnerability.",
          "expected_role": "method",
          "cue_keywords": [
            "graph",
            "neural",
            "networks",
            "famously",
            "easy",
