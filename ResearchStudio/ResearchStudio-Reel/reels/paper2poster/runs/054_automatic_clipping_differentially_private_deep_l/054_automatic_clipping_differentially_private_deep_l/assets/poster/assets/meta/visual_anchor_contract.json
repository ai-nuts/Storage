        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_third_they_show_any_positive",
          "text": "Third, they show any positive constant threshold is equivalent to setting it to one, so a single default suffices.",
          "expected_role": "content",
          "cue_keywords": [
            "third",
            "they",
            "show",
            "any",
