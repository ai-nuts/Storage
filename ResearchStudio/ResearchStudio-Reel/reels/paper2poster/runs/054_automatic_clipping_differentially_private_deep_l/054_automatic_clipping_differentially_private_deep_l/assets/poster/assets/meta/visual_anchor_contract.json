        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_second_they_prove_automatic_dp_sgd",
          "text": "Second, they prove that automatic DP-SGD converges in the non-convex setting at the same asymptotic rate as standard SGD.",
          "expected_role": "content",
          "cue_keywords": [
            "second",
            "they",
            "prove",
            "automatic",
