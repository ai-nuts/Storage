          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_large_models_grid_search_take",
          "text": "For large models this grid search can take days to months of compute, and because it inspects private data it also spends additional privacy budget.",
          "expected_role": "content",
          "cue_keywords": [
            "large",
            "models",
            "grid",
            "search",
            "take",
            "days",
            "months",
            "compute",
            "because",
            "inspects"
