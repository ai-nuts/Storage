      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_authors_make_four_contributions_firs",
          "text": "The authors make four contributions. First, they propose automatic clipping, which mathematically expunges the clipping threshold from general DP optimizers including DP-SGD, DP-Adam, and DP-LAMB.",
          "expected_role": "content",
          "cue_keywords": [
