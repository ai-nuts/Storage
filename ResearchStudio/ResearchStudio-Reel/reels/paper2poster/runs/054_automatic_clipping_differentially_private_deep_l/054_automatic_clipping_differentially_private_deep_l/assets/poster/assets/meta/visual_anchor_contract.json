      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_searching_jointly_over_clipping_thre",
          "text": "Searching jointly over the clipping threshold and the learning rate is one of the main reasons DP training is painful.",
          "expected_role": "method",
