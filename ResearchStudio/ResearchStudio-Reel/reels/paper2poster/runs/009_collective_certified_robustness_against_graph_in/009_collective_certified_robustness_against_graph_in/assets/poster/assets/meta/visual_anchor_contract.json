    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_key_insight_real_world_attacker",
          "text": "Here is the key insight. In the real world, an attacker cannot conjure a different graph for every node they want to fool.",
          "expected_role": "content",
          "cue_keywords": [
            "key",
            "insight",
            "real",
            "world",
            "attacker",
            "cannot",
            "conjure",
            "different",
            "graph",
            "every"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_they_inject_one_perturbed_graph",
          "text": "They inject one perturbed graph, and that single graph has to disrupt the entire set of target nodes at the same time.",
          "expected_role": "content",
          "cue_keywords": [
            "they",
            "inject",
            "one",
            "perturbed",
            "graph",
            "single",
            "graph",
            "disrupt",
            "entire",
            "set"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_certify_whole_target_set_jointly",
          "text": "If we certify the whole target set jointly instead of one node at a time, the guarantee should be much stronger.",
          "expected_role": "method",
          "cue_keywords": [
            "certify",
            "whole",
            "target",
            "set",
            "jointly",
            "instead",
            "one",
            "node",
            "time",
            "guarantee"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s03_c04",
          "anchor_id": "cue_s03_c4_prior_collective_methods_existed_edg",
          "text": "Prior collective methods existed for edge-modification attacks, but they assume a fixed receptive field and simply do not carry over to injection attacks, which expand the receptive field by adding new edges.",
          "expected_role": "method",
          "cue_keywords": [
            "prior",
            "collective",
            "methods",
            "existed",
            "edge-modification",
            "attacks",
            "but",
