    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_graph_neural_networks_workhorses_gra",
          "text": "Graph neural networks are the workhorses of graph learning, but they can be broken by a graph injection attack that slips a handful of malicious nodes into the graph.",
          "expected_role": "content",
          "cue_keywords": [
            "graph",
            "neural",
            "networks",
            "workhorses",
            "graph",
            "learning",
            "but",
            "they",
            "broken",
            "graph"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_trust_these_models_want_certified",
          "text": "To trust these models we want certified robustness, a mathematical guarantee that predictions stay stable under attack.",
          "expected_role": "content",
          "cue_keywords": [
            "trust",
            "these",
            "models",
            "want",
            "certified",
            "robustness",
            "mathematical",
            "guarantee",
            "predictions",
            "stay"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_trouble_every_existing_certificate_i",
          "text": "The trouble is that every existing certificate for injection attacks works node by node, certifying each target in isolation.",
          "expected_role": "content",
          "cue_keywords": [
            "trouble",
            "every",
            "existing",
            "certificate",
            "injection",
            "attacks",
            "works",
            "node",
            "node",
            "certifying"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_sample_wise_view_far_too_pessimistic",
          "text": "That sample-wise view is far too pessimistic, and in practice it certifies almost nothing once the attacker gets a modest budget.",
          "expected_role": "content",
          "cue_keywords": [
            "sample-wise",
            "view",
            "far",
            "too",
            "pessimistic",
            "practice",
            "certifies",
