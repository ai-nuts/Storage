        {
          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_graph_neural_networks_power_everythi",
          "text": "Graph neural networks power everything from citation search to recommendation, but they are alarmingly easy to fool by injecting a few malicious nodes into the graph.",
          "expected_role": "content",
          "cue_keywords": [
            "graph",
            "neural",
            "networks",
            "power",
            "everything",
            "citation",
