        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_tackle_second_bias_they_show",
          "text": "To tackle the second bias, they show it grows with the skew-symmetric part of the Jacobian, and introduce a homeostatic loss that penalizes exactly that part, estimated efficiently with the Hutchinson trace trick.",
          "expected_role": "figure",
          "cue_keywords": [
            "tackle",
            "second",
            "bias",
            "they",
            "show",
            "grows",
            "skew-symmetric",
            "part",
