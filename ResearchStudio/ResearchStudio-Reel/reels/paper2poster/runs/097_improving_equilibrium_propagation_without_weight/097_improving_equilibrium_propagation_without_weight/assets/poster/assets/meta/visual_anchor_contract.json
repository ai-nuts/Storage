          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_sidesteps_yet_its_own_symmetry",
          "text": "EP sidesteps this, yet its own symmetry assumption is nearly as demanding.",
          "expected_role": "content",
          "cue_keywords": [
            "sidesteps",
            "yet",
