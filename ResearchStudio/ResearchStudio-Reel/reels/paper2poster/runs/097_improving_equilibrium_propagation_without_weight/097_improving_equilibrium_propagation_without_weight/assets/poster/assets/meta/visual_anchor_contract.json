    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_equilibrium_propagation_appealing_wa",
          "text": "Equilibrium propagation, or EP, is an appealing way to train neural networks directly on physical substrates like brains or analog chips, because it computes gradients using only the network's own relaxation dynamics.",
          "expected_role": "method",
          "cue_keywords": [
            "equilibrium",
