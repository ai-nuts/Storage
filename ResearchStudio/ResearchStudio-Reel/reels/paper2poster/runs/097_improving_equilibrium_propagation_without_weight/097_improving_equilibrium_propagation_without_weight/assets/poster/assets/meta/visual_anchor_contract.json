          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_payoff_first_time_equilibrium_propag",
          "text": "The payoff: for the first time, equilibrium propagation trains asymmetric networks on ImageNet 32 by 32 with only a small gap to the ideal symmetric case.",
          "expected_role": "result",
          "cue_keywords": [
            "payoff",
            "first",
            "time",
            "equilibrium",
            "propagation",
            "trains",
            "asymmetric",
