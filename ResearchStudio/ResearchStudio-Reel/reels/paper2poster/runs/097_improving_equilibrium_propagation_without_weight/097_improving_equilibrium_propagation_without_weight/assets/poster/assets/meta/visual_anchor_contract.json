          "chunk_index": 1,
          "chunk_id": "s10_c01",
          "anchor_id": "cue_s10_c1_takeaway_equilibrium_propagation_doe",
          "text": "The takeaway is that equilibrium propagation does not actually need perfectly symmetric weights.",
