          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_better_still_estimated_continuously",
          "text": "Better still, this can be estimated continuously over many oscillation cycles, removing the need for separate free and nudged phases.",
          "expected_role": "content",
          "cue_keywords": [
            "better",
            "still",
            "estimated",
            "continuously",
            "over",
            "many",
