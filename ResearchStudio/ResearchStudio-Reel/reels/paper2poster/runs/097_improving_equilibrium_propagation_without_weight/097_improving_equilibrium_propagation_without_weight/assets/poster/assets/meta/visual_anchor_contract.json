    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_reason_matters_energy_physical_neura",
          "text": "The reason this matters is energy. Physical neural systems, whether biological brains or neuromorphic chips, could train networks at a tiny fraction of the energy cost of digital hardware.",
