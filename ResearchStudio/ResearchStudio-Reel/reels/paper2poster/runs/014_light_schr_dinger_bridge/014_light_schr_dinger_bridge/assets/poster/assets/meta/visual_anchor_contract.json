    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_lightsb_starts_goal_minimizing_kullb",
          "text": "LightSB starts from the goal of minimizing the Kullback-Leibler divergence between the true entropic optimal transport plan and a parameterized plan. The obstacle is that we do not know the true plan. The key move is to exploit the known form of that plan and parameterize only the adjusted Schrödinger potential.",
          "expected_role": "content",
          "cue_keywords": [
            "lightsb",
            "starts",
            "goal",
            "minimizing",
            "kullback-leibler",
            "divergence",
