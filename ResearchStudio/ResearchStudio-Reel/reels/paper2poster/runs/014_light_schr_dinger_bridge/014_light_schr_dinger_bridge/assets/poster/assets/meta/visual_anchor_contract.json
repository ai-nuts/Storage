          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_authors_choose_unnormalized_gaussian",
          "text": "The authors choose an unnormalized Gaussian mixture for this potential. Under this choice, two things become tractable in closed form: the conditional distributions of the plan, and the normalization constant.",
          "expected_role": "method",
          "cue_keywords": [
            "authors",
            "choose",
            "unnormalized",
            "gaussian",
            "mixture",
            "potential",
            "under",
            "choice",
            "two",
            "things"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_proposition_3_1_rewrites_objective_s",
          "text": "Proposition 3.1 rewrites the KL objective as a simple difference of two expectations, of the log normalization under the source and the log potential under the target, which can be estimated by Monte Carlo and optimized with ordinary stochastic gradient descent.",
          "expected_role": "content",
          "cue_keywords": [
            "proposition",
            "3.1",
            "rewrites",
            "objective",
            "simple",
            "difference",
            "two",
            "expectations",
            "log",
