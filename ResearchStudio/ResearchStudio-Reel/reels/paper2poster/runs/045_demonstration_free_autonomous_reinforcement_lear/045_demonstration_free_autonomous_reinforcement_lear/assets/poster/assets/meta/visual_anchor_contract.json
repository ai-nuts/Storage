          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_reinforcement_learning_mastered_comp",
          "text": "Reinforcement learning has mastered complex skills, but almost always by assuming the environment resets to a fixed initial state after every episode.",
          "expected_role": "content",
          "cue_keywords": [
            "reinforcement",
            "learning",
            "mastered",
