    },
    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_core_contribution_method_called_ibc",
          "text": "The core contribution is a method called IBC, short for Implicit and Bidirectional Curriculum. As far as the authors know, it is the first algorithm for non-episodic reinforcement learning that consistently learns without any manual resets and without any demonstrations. It brings together two ideas.",
          "expected_role": "method",
          "cue_keywords": [
            "core",
            "contribution",
            "method",
            "called",
            "ibc",
            "short",
            "implicit",
            "bidirectional",
            "curriculum",
            "far"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_first_conditionally_activated_auxili",
          "text": "The first is a conditionally activated auxiliary agent that forms an implicit curriculum: it helps the main agent early on and then gradually disappears as the main agent becomes capable.",
          "expected_role": "content",
          "cue_keywords": [
            "first",
            "conditionally",
            "activated",
            "auxiliary",
            "agent",
            "forms",
            "implicit",
            "curriculum",
            "helps",
            "main"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_second_bidirectional_goal_curriculum",
          "text": "The second is a bidirectional goal curriculum, grounded in optimal transport, that automatically proposes intermediate goals for both the forward and the backward directions.",
          "expected_role": "content",
          "cue_keywords": [
            "second",
            "bidirectional",
            "goal",
            "curriculum",
            "grounded",
            "optimal",
            "transport",
            "automatically",
            "proposes",
            "intermediate"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s04_c04",
          "anchor_id": "cue_s04_c4_together_these_let_agent_bootstrap",
          "text": "Together these let the agent bootstrap its own training signal, and across six sparse-reward environments IBC beats methods that rely on expert data while approaching the performance of an idealized episodic oracle.",
          "expected_role": "method",
          "cue_keywords": [
            "together",
            "these",
            "let",
            "agent",
            "bootstrap",
            "its",
            "own",
            "signal",
            "across",
