          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_hard_combinatorial_optimization_gene",
          "text": "This is a hard combinatorial optimization, in general PSPACE-complete.",
          "expected_role": "content",
          "cue_keywords": [
            "hard",
            "combinatorial",
            "optimization",
            "general",
            "pspace-complete"
          ],
          "required": true
