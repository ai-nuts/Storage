    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_main_contribution_moccasin_constrain",
          "text": "The paper's main contribution is Moccasin, a constraint programming formulation of tensor rematerialization.",
          "expected_role": "method",
          "cue_keywords": [
            "main",
            "contribution",
            "moccasin",
            "constraint",
            "programming",
            "formulation",
            "tensor",
            "rematerialization"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_its_central_idea_represent_node",
          "text": "Its central idea is to represent each node's decisions as a small number of retention intervals, defined by the start and end event of the tensor's lifetime, which reduces the count of discrete variables from quadratic to linear in the number of nodes.",
          "expected_role": "content",
          "cue_keywords": [
            "its",
            "central",
            "idea",
            "represent",
            "node",
            "decisions",
            "small",
            "number",
            "retention",
            "intervals"
