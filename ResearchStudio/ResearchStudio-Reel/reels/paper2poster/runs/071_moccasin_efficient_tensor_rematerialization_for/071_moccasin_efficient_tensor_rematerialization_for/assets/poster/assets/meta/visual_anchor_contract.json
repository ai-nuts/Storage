          "chunk_id": "s04_c04",
          "anchor_id": "cue_s04_c4_payoff_order_of_magnitude_speedup_ov",
          "text": "The payoff is up to an order-of-magnitude speedup over prior work on large graphs.",
          "expected_role": "content",
          "cue_keywords": [
