        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_whole_handed_google_or_tools_cp_sat",
          "text": "The whole model is handed to Google OR-Tools' CP-SAT solver. Because each node uses only a small constant number of intervals, the total number of integer variables stays linear in the graph size.",
          "expected_role": "content",
          "cue_keywords": [
            "whole",
