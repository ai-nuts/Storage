    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_neural_networks_running_edge_devices",
          "text": "Neural networks running on edge devices are constrained above all by memory.",
          "expected_role": "method",
