        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_one_way_fit_large_small",
          "text": "One way to fit a large model into a small memory footprint is rematerialization: instead of storing every intermediate tensor, you recompute some of them on demand. The catch is that recomputation costs time.",
          "expected_role": "content",
          "cue_keywords": [
            "one",
            "way",
            "fit",
            "large",
            "small",
            "memory",
            "footprint",
            "rematerialization",
            "instead",
