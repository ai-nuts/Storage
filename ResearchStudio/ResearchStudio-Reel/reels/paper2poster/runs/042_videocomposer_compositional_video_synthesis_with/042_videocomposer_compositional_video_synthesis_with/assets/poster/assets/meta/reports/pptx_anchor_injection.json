      "target_source": "svg"
    },
    {
      "slide_index": 7,
      "anchor_id": "cue_s07_c2_competitive_leading_text_to_video_sy",
      "chunk_index": 2,
      "chunk_id": "s07_c02",
      "text": "That is competitive with leading text-to-video systems, and it improves over the model's first-stage pre-training, which scored eight hundred three.",
