      "chunk_index": 1,
      "chunk_id": "s01_c01",
      "text": "Contrast-Consistent Search, or CCS, is an unsupervised probe that reads a language model's sense of truth from its activations.",
      "box": [
        0.05,
        0.3556,
        0.5469,
        0.0722
      ],
      "target_source": "pptx"
    },
