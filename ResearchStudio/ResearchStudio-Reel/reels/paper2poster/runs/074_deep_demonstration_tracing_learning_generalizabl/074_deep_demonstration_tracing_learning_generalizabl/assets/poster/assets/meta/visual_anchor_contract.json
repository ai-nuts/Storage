          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_second_piece_rather_behavior_cloning",
          "text": "The second piece is training. Rather than behavior cloning, DDT frames one-shot imitation as context-based meta-reinforcement learning, so the agent can explore and learn to act in states the demonstration never visited.",
          "expected_role": "method",
          "cue_keywords": [
            "second",
            "piece",
            "rather",
            "behavior",
            "cloning",
            "ddt",
            "frames",
            "one-shot",
            "imitation",
            "context-based"
