        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_carefully_designed_stationary_osil_r",
          "text": "It uses a carefully designed stationary OSIL reward that rewards following the demonstration while a large-weighted task reward keeps the focus on actually completing the task, and it optimizes everything with Soft Actor-Critic.",
          "expected_role": "method",
          "cue_keywords": [
            "carefully",
            "designed",
