        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_maxcut_instance_over_two_billion",
          "text": "On a MaxCut instance with over two billion variables, USBS delivers a five-hundred-times speedup over the previous state of the art, and warm-starting alone can accelerate convergence by more than one hundred times.",
          "expected_role": "content",
          "cue_keywords": [
            "maxcut",
            "instance",
