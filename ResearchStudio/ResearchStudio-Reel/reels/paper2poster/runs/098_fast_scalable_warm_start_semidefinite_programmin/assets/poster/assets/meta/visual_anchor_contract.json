    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_presents_usbs_unified_spectral_bundl",
          "text": "This paper presents USBS, a unified spectral bundle method with sketching. It makes several contributions. First, it handles general SDPs with both equality and inequality constraints, unlike prior spectral bundle methods.",
          "expected_role": "method",
          "cue_keywords": [
            "presents",
            "usbs",
            "unified",
            "spectral",
            "bundle",
            "method",
