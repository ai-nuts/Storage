        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_introduces_usbs_unified_spectral_bun",
          "text": "This paper introduces USBS, Unified Spectral Bundling with Sketching, a provably correct solver that is fast, scales to billions of decision variables, and, crucially, can reuse a previous solution as a warm start.",
          "expected_role": "content",
          "cue_keywords": [
