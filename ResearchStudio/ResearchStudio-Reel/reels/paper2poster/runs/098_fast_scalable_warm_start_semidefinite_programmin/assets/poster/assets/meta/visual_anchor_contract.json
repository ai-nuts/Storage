        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_semidefinite_programs_enormous_range",
          "text": "Semidefinite programs can model an enormous range of practical problems, from combinatorial optimization to neural network verification and control. But solving them at scale is hard.",
          "expected_role": "content",
          "cue_keywords": [
            "semidefinite",
            "programs",
