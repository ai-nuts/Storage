      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_architecture_two_major_parts_coarse",
          "text": "The architecture has two major parts: coarse-to-fine visual-language reasoning for the answer, and an explanation generation module. A pre-trained Faster-RCNN extracts region-of-interest features and image predicates such as object and attribute labels, which are embedded with GloVe. The question is encoded with GloVe embeddings passed through a GRU, and question predicates are extracted by filtering out stop words.",
          "expected_role": "method",
          "cue_keywords": [
