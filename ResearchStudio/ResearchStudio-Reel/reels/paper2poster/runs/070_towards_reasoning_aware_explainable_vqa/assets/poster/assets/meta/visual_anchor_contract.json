        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_these_signals_flow_through_three",
          "text": "These signals flow through three modules: information filtering, which removes noisy region information; multimodal learning, which uses bilinear attention networks to fuse image and question at both coarse and fine granularity; and semantic reasoning, which combines the two levels into a joint embedding.",
          "expected_role": "method",
          "cue_keywords": [
            "these",
            "signals",
            "flow",
            "through",
            "three",
            "modules",
            "information",
            "filtering",
