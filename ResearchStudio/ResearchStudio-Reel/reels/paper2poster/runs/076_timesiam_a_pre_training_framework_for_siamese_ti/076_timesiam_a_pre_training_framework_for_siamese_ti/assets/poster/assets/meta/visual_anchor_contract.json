        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_randomly_masking_series_computing_se",
          "text": "Randomly masking a series or computing series-wise similarity tends to distort or ignore the temporal correlations that make time series meaningful. This paper introduces TimeSiam, a simple but effective self-supervised framework built on Siamese networks.",
          "expected_role": "result",
          "cue_keywords": [
            "randomly",
            "masking",
            "series",
            "computing",
            "series-wise",
            "similarity",
            "tends",
            "distort",
            "ignore",
            "temporal"
