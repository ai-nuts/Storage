      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_makes_three_main_contributions_first",
          "text": "This paper makes three main contributions. First, it proposes TimeSiam, a simple but effective pre-training framework that uses Siamese networks to capture correlations among temporally distanced subseries.",
