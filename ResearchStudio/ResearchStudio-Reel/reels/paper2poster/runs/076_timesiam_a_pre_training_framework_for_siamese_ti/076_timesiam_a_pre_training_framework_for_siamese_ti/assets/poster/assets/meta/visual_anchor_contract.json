        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_learnable_lineage_embeddings_let_sin",
          "text": "Learnable lineage embeddings let a single model capture correlations at many different time distances. Across thirteen benchmarks and two mainstream tasks, forecasting and classification, TimeSiam sets a new state of the art in both in-domain and cross-domain settings.",
          "expected_role": "method",
          "cue_keywords": [
            "learnable",
            "lineage",
            "embeddings",
            "let",
            "single",
            "capture",
