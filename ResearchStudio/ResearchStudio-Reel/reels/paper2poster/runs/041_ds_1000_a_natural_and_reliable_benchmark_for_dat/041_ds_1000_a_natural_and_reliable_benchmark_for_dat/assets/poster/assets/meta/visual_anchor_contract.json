      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_ds_1000_built_through_five_stage_pip",
          "text": "DS-1000 is built through a five-stage pipeline. Annotators first select high-vote, testable, useful, and representative StackOverflow problems and rewrite them for clarity. They add a code context with insertion markers showing exactly where the model must fill in code.",
          "expected_role": "method",
          "cue_keywords": [
