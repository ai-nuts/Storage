        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_they_implement_automatic_tests_check",
          "text": "They then implement automatic tests that check functional correctness by executing test cases and also enforce surface-form constraints, such as forbidding certain APIs or keywords in the syntax tree.",
          "expected_role": "method",
          "cue_keywords": [
