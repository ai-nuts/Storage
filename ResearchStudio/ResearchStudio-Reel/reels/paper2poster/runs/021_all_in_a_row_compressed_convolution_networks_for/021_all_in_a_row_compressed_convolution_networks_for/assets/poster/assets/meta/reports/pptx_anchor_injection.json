        0.2083,
        0.9,
        0.0917
      ],
      "target_source": "svg"
    },
    {
      "slide_index": 4,
      "anchor_id": "cue_s04_c2_first_differentiable_regularization",
      "chunk_index": 2,
      "chunk_id": "s04_c02",
      "text": "First, a differentiable regularization for graphs: a learnable permutation that lines nodes into a single row while preserving permutation invariance, so Euclidean convolution finally applies.",
