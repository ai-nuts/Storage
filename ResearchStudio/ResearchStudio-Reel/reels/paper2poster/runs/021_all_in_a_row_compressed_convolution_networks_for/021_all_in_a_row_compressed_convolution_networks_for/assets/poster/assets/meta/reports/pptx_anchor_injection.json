        0.4391,
        0.2944
      ],
      "target_source": "svg"
    },
    {
      "slide_index": 4,
      "anchor_id": "cue_s04_c4_learns_both_node_structure_features",
      "chunk_index": 4,
      "chunk_id": "s04_c04",
      "text": "It learns both node and structure features and trains end to end, beating competitive GNNs and pooling models.",
