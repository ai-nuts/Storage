        0.05,
        0.325,
        0.4391,
        0.2944
      ],
      "target_source": "svg"
    },
    {
      "slide_index": 4,
      "anchor_id": "cue_s04_c3_second_built_compressed_convolution",
      "chunk_index": 3,
      "chunk_id": "s04_c03",
      "text": "Second, the model built on it, the Compressed Convolution Network, or CoCN.",
