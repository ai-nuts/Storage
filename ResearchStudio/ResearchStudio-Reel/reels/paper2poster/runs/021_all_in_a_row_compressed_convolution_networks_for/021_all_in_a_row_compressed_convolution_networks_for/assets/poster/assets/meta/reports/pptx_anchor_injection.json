        0.1944
      ],
      "target_source": "svg"
    },
    {
      "slide_index": 4,
      "anchor_id": "cue_s04_c1_makes_two_contributions",
      "chunk_index": 1,
      "chunk_id": "s04_c01",
      "text": "The paper makes two contributions.",
      "box": [
