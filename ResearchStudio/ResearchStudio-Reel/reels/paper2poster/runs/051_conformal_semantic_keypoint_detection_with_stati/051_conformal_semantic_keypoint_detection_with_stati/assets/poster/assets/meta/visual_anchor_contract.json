      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_why_hard_authors_name_three",
          "text": "Why is this hard? The authors name three challenges. First, neural keypoint detectors can be arbitrarily wrong, producing outliers.",
          "expected_role": "content",
          "cue_keywords": [
            "why",
