        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_third_most_fundamental_provably_corr",
          "text": "Third, and most fundamental, there is no provably correct uncertainty quantification, no formal worst-case error bound between estimate and groundtruth.",
          "expected_role": "result",
          "cue_keywords": [
            "third",
            "most",
            "fundamental",
            "provably",
            "correct",
            "uncertainty",
