    {
      "index": 4,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_method_two_stages_conformal_keypoint",
          "text": "The method has two stages. In conformal keypoint detection, a calibration set of labeled images gives nonconformity scores for the heatmap detector.",
          "expected_role": "method",
          "cue_keywords": [
            "method",
            "two",
            "stages",
            "conformal",
            "keypoint",
            "detection",
            "calibration",
            "set",
            "labeled",
            "images"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_two_designs_offered_peak_score",
          "text": "Two designs are offered: a peak score, the scaled distance from the true keypoint to the most probable pixel, and a covariance score, a Mahalanobis distance over top detections, yielding circular and elliptical sets.",
          "expected_role": "method",
          "cue_keywords": [
            "two",
            "designs",
            "offered",
            "peak",
            "score",
            "scaled",
            "distance",
            "true",
            "keypoint",
            "most"
