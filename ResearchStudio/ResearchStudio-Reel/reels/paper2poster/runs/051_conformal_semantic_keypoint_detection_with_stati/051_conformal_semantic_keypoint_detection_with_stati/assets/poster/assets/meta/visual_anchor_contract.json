          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_dominant_recipe_two_stages_first",
          "text": "The dominant recipe is two stages: first detect semantic keypoints, then recover the pose by minimizing reprojection error through Perspective-n-Points.",
          "expected_role": "result",
          "cue_keywords": [
