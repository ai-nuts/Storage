        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_these_methods_score_well_benchmarks",
          "text": "These methods score well on benchmarks, yet they return a single pose with no statement about how trustworthy it is.",
          "expected_role": "method",
          "cue_keywords": [
            "these",
