          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_nvidia_research_cvpr_2023_work",
          "text": "From NVIDIA Research at CVPR 2023, this work closes a safety-critical gap in object pose estimation. Standard two-stage pipelines detect keypoints, then solve for the 6D pose, but give no guarantee on how wrong the answer might be. The authors add two pieces.",
          "expected_role": "method",
          "cue_keywords": [
            "nvidia",
            "research",
            "cvpr",
            "2023",
            "work",
            "closes",
