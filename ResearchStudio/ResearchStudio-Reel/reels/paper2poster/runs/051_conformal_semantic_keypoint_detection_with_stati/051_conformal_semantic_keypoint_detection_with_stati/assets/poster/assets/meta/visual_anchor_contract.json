          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_second_rejecting_those_outliers_nonc",
          "text": "Second, rejecting those outliers is a nonconvex optimization; fast heuristics like RANSAC are common but cannot guarantee global optimality and can fail silently.",
          "expected_role": "content",
          "cue_keywords": [
            "second",
            "rejecting",
