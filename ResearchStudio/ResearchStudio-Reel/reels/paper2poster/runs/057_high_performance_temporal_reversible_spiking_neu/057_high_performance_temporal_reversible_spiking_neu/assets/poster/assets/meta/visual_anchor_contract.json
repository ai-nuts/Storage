          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_inference_repeating_input_over_steps",
          "text": "At inference, repeating the input over T steps makes the energy scale with T as well.",
          "expected_role": "content",
          "cue_keywords": [
