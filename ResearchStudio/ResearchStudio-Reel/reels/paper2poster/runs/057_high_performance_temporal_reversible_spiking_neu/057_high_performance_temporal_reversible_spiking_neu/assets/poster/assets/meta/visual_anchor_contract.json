    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_key_insight_behind_work_surprisingly",
          "text": "The key insight behind this work is surprisingly simple. When the authors examined the gradients that flow backward through time in a spiking network, they found that for most neurons those temporal gradients barely matter.",
          "expected_role": "content",
          "cue_keywords": [
            "key",
            "insight",
            "behind",
            "work",
            "surprisingly",
            "simple",
            "when",
            "authors",
            "examined",
            "gradients"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_only_neurons_few_key_positions",
          "text": "Only the neurons at a few key positions carry temporal information that is actually important. If that is true, then a natural question follows: why pay the full temporal cost for every neuron?",
          "expected_role": "title",
          "cue_keywords": [
            "only",
            "neurons",
            "few",
            "key",
            "positions",
            "carry",
            "temporal",
            "information",
            "actually",
            "important"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_prior_methods_either_decouple_timest",
          "text": "Prior methods either decouple training from the timestep to save memory, or shrink the number of inference steps to save energy, but each one solves only half of the problem.",
          "expected_role": "method",
          "cue_keywords": [
            "prior",
            "methods",
            "either",
            "decouple",
            "timestep",
            "save",
            "memory",
            "shrink",
            "number",
            "inference"
