          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s03_c04",
          "anchor_id": "cue_s03_c4_asks_whether_both_halves_solved",
          "text": "This paper asks whether both halves can be solved together.",
          "expected_role": "title",
          "cue_keywords": [
            "asks",
            "whether",
            "both",
            "halves",
            "solved",
            "together"
          ],
          "required": true
