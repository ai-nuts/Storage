      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_spiking_neural_networks_appealing_be",
          "text": "Spiking Neural Networks are appealing because they promise brain-inspired, low-power computation. But to work well they are simulated over many timesteps, and that comes at a steep cost.",
          "expected_role": "content",
          "cue_keywords": [
