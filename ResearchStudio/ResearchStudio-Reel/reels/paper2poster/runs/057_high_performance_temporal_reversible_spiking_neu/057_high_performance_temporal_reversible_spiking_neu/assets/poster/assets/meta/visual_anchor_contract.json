          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_during_memory_grows_both_number",
          "text": "During training, memory grows with both the number of layers and the number of timesteps, on the order of L times T.",
          "expected_role": "method",
          "cue_keywords": [
