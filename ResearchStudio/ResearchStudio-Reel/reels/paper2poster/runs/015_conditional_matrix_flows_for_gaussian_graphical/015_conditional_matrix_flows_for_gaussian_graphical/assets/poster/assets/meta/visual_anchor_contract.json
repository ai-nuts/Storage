        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_ideal_l_zero_penalty_counts_edges",
          "text": "The ideal l-zero penalty that counts edges is combinatorial and intractable.",
          "expected_role": "content",
          "cue_keywords": [
