        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_gaussian_graphical_models_read_condi",
          "text": "Gaussian Graphical Models read conditional independence from the precision matrix, the inverse covariance: a zero entry means two variables are conditionally independent, so a sparse precision matrix recovers the network.",
          "expected_role": "content",
          "cue_keywords": [
