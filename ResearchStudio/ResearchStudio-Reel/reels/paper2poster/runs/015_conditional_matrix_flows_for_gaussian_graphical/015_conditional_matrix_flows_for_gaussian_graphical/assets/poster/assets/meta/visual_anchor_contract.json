            "matrix"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_hypernetwork_feeds_lambda_minimizes",
          "text": "A hypernetwork feeds in lambda and q, and training minimizes the KL divergence to the unnormalized posterior under a generalized-Normal prior.",
          "expected_role": "method",
          "cue_keywords": [
