          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_variational_inference_could_bridge_t",
          "text": "Variational inference could bridge them, yet the usual mean-field trick assumes independence, exactly what a graphical model seeks.",
          "expected_role": "content",
