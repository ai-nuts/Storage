      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_two_camps_exist_frequentist_graphica",
          "text": "Two camps exist. The frequentist Graphical Lasso traces the whole solution path as lambda varies, but returns only point estimates.",
