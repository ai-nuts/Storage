        },
        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_many_defenses_improve_robustness_emp",
          "text": "Many defenses improve robustness empirically, yet almost none can certify it with guarantees. This paper introduces CROP, the first unified framework to certify robust policies for reinforcement learning through functional smoothing.",
          "expected_role": "guidance",
          "cue_keywords": [
            "many",
            "defenses",
            "improve",
            "robustness",
            "empirically",
