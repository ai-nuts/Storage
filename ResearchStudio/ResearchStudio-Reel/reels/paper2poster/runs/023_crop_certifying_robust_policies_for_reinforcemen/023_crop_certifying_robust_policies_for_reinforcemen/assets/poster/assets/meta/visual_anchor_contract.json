        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_crop_certifies_robustness_two_levels",
          "text": "CROP certifies robustness at two levels: the stability of the action taken at each state, and a provable lower bound on the cumulative reward across a whole trajectory.",
          "expected_role": "figure",
          "cue_keywords": [
            "crop",
            "certifies",
            "robustness",
            "two",
            "levels",
            "stability",
            "action",
