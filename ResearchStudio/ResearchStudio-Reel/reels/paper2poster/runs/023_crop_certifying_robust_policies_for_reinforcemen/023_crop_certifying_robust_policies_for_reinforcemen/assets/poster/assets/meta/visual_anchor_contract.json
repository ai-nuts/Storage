        },
        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_what_been_missing_certification_way",
          "text": "What has been missing is certification: a way to prove, rather than just observe, that a trained policy stays reliable under every perturbation within a bounded budget.",
          "expected_role": "method",
          "cue_keywords": [
            "what",
            "been",
            "missing",
            "certification",
            "way",
