    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_reinforcement_learning_moved_domains",
          "text": "Reinforcement learning has moved into domains where failure is costly, such as autonomous driving and trading.",
          "expected_role": "content",
          "cue_keywords": [
