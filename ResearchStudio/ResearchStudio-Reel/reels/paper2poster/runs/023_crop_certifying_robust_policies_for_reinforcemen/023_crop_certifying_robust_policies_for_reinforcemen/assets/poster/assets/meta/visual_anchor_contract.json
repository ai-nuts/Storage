        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_crop_gre_global_smoothing_bound_expe",
          "text": "CROP-GRe uses global smoothing to bound the expected and percentile reward, and CROP-LoRe performs an adaptive tree search to produce a much tighter absolute lower bound on reward.",
          "expected_role": "content",
          "cue_keywords": [
            "crop-gre",
            "global",
            "smoothing",
            "bound",
            "expected",
            "percentile",
