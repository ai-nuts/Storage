          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_tackles_exactly_gap_reinforcement_le",
          "text": "This paper tackles exactly that gap for reinforcement learning.",
          "expected_role": "content",
          "cue_keywords": [
