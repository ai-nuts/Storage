        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_other_approaches_collect_on_policy_a",
          "text": "Other approaches collect on-policy data or add extra human oracles, which are slow and costly.",
          "expected_role": "content",
          "cue_keywords": [
            "other",
            "approaches",
            "collect",
            "on-policy",
            "add",
            "extra",
            "human",
            "oracles",
            "which",
