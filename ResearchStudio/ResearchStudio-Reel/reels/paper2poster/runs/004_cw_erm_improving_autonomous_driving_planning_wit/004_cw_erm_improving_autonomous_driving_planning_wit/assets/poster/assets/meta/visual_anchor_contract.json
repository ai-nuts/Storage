        {
          "chunk_index": 2,
          "chunk_id": "s07_c02",
          "anchor_id": "cue_s07_c2_when_upsamples_front_collision_scene",
          "text": "When the model upsamples front-collision scenes, front collisions fall from fourteen to nine.",
