          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_mismatch_quietly_hurts_real_world_sa",
          "text": "This mismatch quietly hurts real-world safety.",
          "expected_role": "content",
          "cue_keywords": [
