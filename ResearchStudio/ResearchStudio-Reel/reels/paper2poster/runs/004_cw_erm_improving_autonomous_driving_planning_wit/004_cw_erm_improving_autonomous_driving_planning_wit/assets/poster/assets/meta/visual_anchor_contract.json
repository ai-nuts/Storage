    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_been_attempts_close_gap_methods",
          "text": "\"There have been attempts to close this gap. Methods like Urban Driver run a differentiable simulator directly inside the training loop using backpropagation through time.",
          "expected_role": "method",
          "cue_keywords": [
            "been",
            "attempts",
            "close",
            "gap",
            "methods",
            "like",
            "urban",
            "driver",
            "run",
            "differentiable"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_works_but_expensive_requires_differe",
          "text": "This works, but it is expensive: it requires a differentiable simulator, it does not scale well, and it carries the heavy memory cost of unrolling policies during training.",
          "expected_role": "method",
          "cue_keywords": [
            "works",
            "but",
            "expensive",
            "requires",
            "differentiable",
            "simulator",
            "does",
            "not",
            "scale",
            "well"
