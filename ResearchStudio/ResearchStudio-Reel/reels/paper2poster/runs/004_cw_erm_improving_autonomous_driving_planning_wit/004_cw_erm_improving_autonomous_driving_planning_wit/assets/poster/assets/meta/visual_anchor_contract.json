      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s08_c01",
          "anchor_id": "cue_s08_c1_ablations_reveal_how_method_well",
          "text": "\"The ablations reveal how to use the method well. Targeting a single metric in isolation gives the largest improvement on that metric, while combining metrics achieves a balance, tracing out a Pareto front of trade-offs.",
