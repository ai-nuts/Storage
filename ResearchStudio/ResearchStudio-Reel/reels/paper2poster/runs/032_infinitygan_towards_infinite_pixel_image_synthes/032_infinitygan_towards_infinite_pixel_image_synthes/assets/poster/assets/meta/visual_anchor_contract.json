        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_infinitygan_generator_two_modules_st",
          "text": "InfinityGAN's generator has two modules. The structure synthesizer is a neural implicit function: it takes a global latent for scene appearance, a local latent tensor for variation, and a continuous coordinate grid, and outputs a structural latent for any region.",
          "expected_role": "method",
          "cue_keywords": [
            "infinitygan",
            "generator",
            "two",
            "modules",
            "structure",
            "synthesizer",
