        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_coordinates_sine_cosine_horizontally",
          "text": "Coordinates use sine-cosine horizontally to exploit landscape self-similarity and a tanh vertically for the ground-to-sky gradient, so it can be queried infinitely far from the origin.",
          "expected_role": "content",
          "cue_keywords": [
            "coordinates",
            "sine-cosine",
