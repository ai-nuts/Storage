        0.5156,
        0.2722,
        0.4281,
        0.2778
      ],
      "target_source": "svg"
    },
    {
      "slide_index": 4,
      "anchor_id": "cue_s04_c3_simulated_its_attention_maps_recover",
      "chunk_index": 3,
      "chunk_id": "s04_c03",
      "text": "On simulated data, its attention maps recover directed connectivity, including hub neurons correlation misses.",
      "box": [
        0.0563,
        0.5833,
        0.4281,
        0.2778
      ],
      "target_source": "svg"
    },
    {
