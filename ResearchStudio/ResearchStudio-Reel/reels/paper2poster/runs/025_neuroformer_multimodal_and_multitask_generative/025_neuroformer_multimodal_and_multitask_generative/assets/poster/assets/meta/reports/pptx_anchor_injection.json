        0.284,
        0.2722
      ],
      "target_source": "svg"
    },
    {
      "slide_index": 1,
      "anchor_id": "cue_s01_c2_reframes_cellular_resolution_spike_a",
      "chunk_index": 2,
      "chunk_id": "s01_c02",
      "text": "It reframes cellular-resolution spike analysis as autoregressive spatiotemporal generation, borrowing the recipe behind large language and vision models.",
      "box": [
        0.3594,
        0.6278,
        0.2812,
        0.2722
      ],
      "target_source": "svg"
    },
    {
