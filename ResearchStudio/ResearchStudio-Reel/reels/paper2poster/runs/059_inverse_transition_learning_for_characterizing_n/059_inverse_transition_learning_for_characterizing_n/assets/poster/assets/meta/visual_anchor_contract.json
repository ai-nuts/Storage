      ]
    },
    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_work_introduces_inverse_transition_l",
          "text": "This work introduces Inverse Transition Learning, a gradient free and constraint based approach.",
          "expected_role": "method",
          "cue_keywords": [
            "work",
            "introduces",
            "inverse",
            "transition",
            "learning",
            "gradient",
            "free",
            "constraint",
            "based",
            "approach"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_converts_near_optimal_expert_policy",
          "text": "It converts a near optimal expert policy into a set of constraints on the transition dynamics, and then clips a Bayesian posterior over the dynamics so that every sampled model yields a safe and high performing policy.",
          "expected_role": "method",
          "cue_keywords": [
            "converts",
            "near",
            "optimal",
            "expert",
            "policy",
            "set",
            "constraints",
            "transition",
            "dynamics",
            "clips"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_beyond_method_itself_carefully_analy",
          "text": "Beyond the method itself, the paper carefully analyzes when and why maximum likelihood estimation of the dynamics breaks down under uneven data coverage, and it shows how combining the constraints with uncertainty produces an informative ranking of actions in the states where the expert is unsure.",
          "expected_role": "method",
          "cue_keywords": [
            "beyond",
            "method",
            "itself",
            "carefully",
            "analyzes",
            "when",
            "why",
            "maximum",
            "likelihood",
            "estimation"
          ],
          "required": true
        }
      ]
