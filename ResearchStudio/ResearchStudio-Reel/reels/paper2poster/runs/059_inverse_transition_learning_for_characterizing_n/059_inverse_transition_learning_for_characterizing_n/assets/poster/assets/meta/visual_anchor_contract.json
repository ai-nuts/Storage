    {
      "index": 7,
      "id": "key-result",
      "heading": "Key Result",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s07_c01",
          "anchor_id": "cue_s07_c1_clipped_posterior_dominates_both_max",
          "text": "The clipped posterior dominates both maximum likelihood and the un clipped Bayesian posterior.",
