    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_given_rewards_epsilon_optimal_expert",
          "text": "Given the rewards, an epsilon optimal expert policy, and the batch data, we use the closed form Bellman equations to write constraints that demand the value of actions the expert takes exceed the value of actions the expert never took.",
          "expected_role": "method",
          "cue_keywords": [
            "given",
            "rewards",
            "epsilon",
            "optimal",
            "expert",
            "policy",
            "batch",
            "closed",
            "form",
            "bellman"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_any_dynamics_satisfying_these_constr",
          "text": "Any dynamics satisfying these constraints recovers what we call the expert's epsilon ball structure.",
          "expected_role": "method",
          "cue_keywords": [
            "any",
            "dynamics",
            "satisfying",
            "these",
            "constraints",
            "recovers",
            "what",
            "call",
            "expert",
            "epsilon"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_place_dirichlet_multinomial_posterio",
          "text": "We then place a Dirichlet multinomial posterior over the dynamics and use rejection sampling, keeping only the samples that satisfy the constraints. The surviving samples form a clipped posterior that respects the expert's knowledge.",
          "expected_role": "method",
          "cue_keywords": [
            "place",
            "dirichlet",
            "multinomial",
            "posterior",
            "over",
            "dynamics",
            "rejection",
            "sampling",
            "keeping",
            "only"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_separate_constraint_sets_handle_full",
          "text": "Separate constraint sets handle a fully optimal expert and a partially uncertain one, with a tunable slack term that enforces the structure even where action non linearity would otherwise break it.",
          "expected_role": "method",
          "cue_keywords": [
            "separate",
            "constraint",
            "sets",
            "handle",
            "fully",
            "optimal",
            "expert",
            "partially",
            "uncertain",
            "one"
          ],
          "required": true
        }
      ]
    },
