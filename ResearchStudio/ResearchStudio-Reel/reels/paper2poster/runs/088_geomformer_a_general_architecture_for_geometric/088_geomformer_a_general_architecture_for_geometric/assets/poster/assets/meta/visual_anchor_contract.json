        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_equivariant_stream_standard_attentio",
          "text": "For the equivariant stream, standard attention is modified so the attention score is computed by summing dot products over the three-dimensional Query and Key vectors, which provably preserves equivariance.",
          "expected_role": "method",
          "cue_keywords": [
