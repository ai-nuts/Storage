    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_core_idea_represent_classification_p",
          "text": "The core idea is to represent the classification problem as a conflict hypergraph.",
          "expected_role": "result",
          "cue_keywords": [
            "core",
            "idea",
            "represent",
            "classification",
            "problem",
            "conflict",
            "hypergraph"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_vertex_point_set_points_forms",
          "text": "Each vertex is a data point, and a set of points forms a hyperedge when they belong to different classes yet share overlapping adversarial neighborhoods, meaning an attacker could push any of them to the same confusing input.",
          "expected_role": "content",
          "cue_keywords": [
            "vertex",
            "point",
            "set",
            "points",
            "forms",
            "hyperedge",
            "when",
            "they",
            "belong",
            "different"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_optimal_0_1_loss_becomes",
          "text": "The optimal 0-1 loss then becomes a linear program: maximize the probability mass of correctly classified points subject to constraints encoded by the hypergraph's incidence matrix. The dual program is a fractional covering of vertices by hyperedges, and it directly yields the optimal adversarial strategy.",
          "expected_role": "method",
          "cue_keywords": [
            "optimal",
            "0",
            "1",
            "loss",
            "becomes",
            "linear",
            "program",
            "maximize",
            "probability",
            "mass"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_because_computing_all_hyperedges_deg",
          "text": "Because computing all hyperedges up to degree ten is infeasible, the authors truncate the hypergraph to lower degrees for tractable lower bounds, aggregate binary one-versus-one losses for an even cheaper bound, and apply a generalized Caro-Wei bound for a matching upper bound.",
          "expected_role": "figure",
          "cue_keywords": [
            "because",
            "computing",
            "all",
            "hyperedges",
            "degree",
            "ten",
            "infeasible",
            "authors",
            "truncate",
            "hypergraph"
          ],
          "required": true
        }
      ]
    },
