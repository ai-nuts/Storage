          "chunk_index": 2,
          "chunk_id": "s03_c02",
          "anchor_id": "cue_s03_c2_capturing_requires_nonlinear_maps_le",
          "text": "Capturing this requires nonlinear maps at the level of single cells, not aggregate averages.",
          "expected_role": "result",
          "cue_keywords": [
            "capturing",
