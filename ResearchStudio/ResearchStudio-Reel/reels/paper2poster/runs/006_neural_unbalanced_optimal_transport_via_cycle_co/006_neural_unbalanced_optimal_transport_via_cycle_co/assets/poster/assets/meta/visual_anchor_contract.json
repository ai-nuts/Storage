          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_single_cell_biology_unavoidable_beca",
          "text": "In single-cell biology this is unavoidable, because profiling a cell destroys it, so the same cell can never be measured twice.",
          "expected_role": "method",
          "cue_keywords": [
            "single-cell",
            "biology",
            "unavoidable",
