          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s03_c03",
          "anchor_id": "cue_s03_c3_prior_neural_optimal_transport_metho",
          "text": "Prior neural optimal transport methods can learn such maps, but they either assume the balanced setting where mass is conserved, or, like the state-of-the-art unbalanced GAN approach, they only capture the general trend of growth and shrinkage without recovering the exact reweighting each subpopulation needs.",
          "expected_role": "method",
          "cue_keywords": [
            "prior",
            "neural",
            "optimal",
            "transport",
            "methods",
            "learn",
            "such",
