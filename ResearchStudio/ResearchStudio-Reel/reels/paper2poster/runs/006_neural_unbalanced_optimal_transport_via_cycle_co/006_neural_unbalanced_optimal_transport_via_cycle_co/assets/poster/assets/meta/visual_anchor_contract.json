          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_optimal_transport_offers_principled",
          "text": "Optimal transport offers a principled way to infer these correspondences by learning an optimal coupling between distributions. But the standard formulation assumes conservation of mass, meaning every unit of source mass must be transported somewhere.",
          "expected_role": "method",
          "cue_keywords": [
            "optimal",
            "transport",
            "offers",
            "principled",
            "way",
            "infer",
            "these",
            "correspondences",
            "learning",
