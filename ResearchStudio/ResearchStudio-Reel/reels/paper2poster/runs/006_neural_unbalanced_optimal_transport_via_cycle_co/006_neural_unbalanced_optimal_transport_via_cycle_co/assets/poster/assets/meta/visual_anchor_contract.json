    {
      "index": 3,
      "id": "motivation",
      "heading": "Motivation",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s03_c01",
          "anchor_id": "cue_s03_c1_cellular_responses_drugs_highly_hete",
          "text": "Cellular responses to drugs are highly heterogeneous: different cell types and states can respond in opposite ways, some proliferating while others die.",
