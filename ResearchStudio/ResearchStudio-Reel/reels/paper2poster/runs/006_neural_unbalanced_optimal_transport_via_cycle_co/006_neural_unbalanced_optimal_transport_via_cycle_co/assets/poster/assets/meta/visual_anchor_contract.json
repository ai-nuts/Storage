        },
        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_third_proposes_new_cycle_consistent",
          "text": "Third, it proposes a new cycle-consistent training procedure that alternates between updating these maps and rescaling functions, and crucially generalizes to new, out-of-sample cells.",
          "expected_role": "method",
          "cue_keywords": [
            "third",
