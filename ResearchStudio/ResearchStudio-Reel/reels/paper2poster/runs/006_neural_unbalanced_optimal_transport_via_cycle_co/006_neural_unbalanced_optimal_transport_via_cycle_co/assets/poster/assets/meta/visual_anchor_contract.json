    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_recurring_problem_natural_sciences_m",
          "text": "A recurring problem in the natural sciences is modeling how a population changes after an intervention, when you can only observe unpaired snapshots rather than track individuals.",
          "expected_role": "content",
          "cue_keywords": [
            "recurring",
            "problem",
            "natural",
            "sciences",
            "modeling",
            "how",
            "population",
            "changes",
            "after",
            "intervention"
