          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_assumption_violated_exactly_when_mat",
          "text": "That assumption is violated exactly when it matters most, in unbalanced settings where cells proliferate or die, and the total population size shifts between measurements.",
          "expected_role": "content",
          "cue_keywords": [
