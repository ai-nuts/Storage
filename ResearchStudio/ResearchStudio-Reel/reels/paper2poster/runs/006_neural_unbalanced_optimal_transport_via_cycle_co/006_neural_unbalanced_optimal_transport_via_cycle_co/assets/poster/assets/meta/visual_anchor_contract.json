          "chunk_id": "s03_c04",
          "anchor_id": "cue_s03_c4_what_been_missing_method_jointly",
          "text": "What has been missing is a method that jointly and accurately models where mass moves and how much of it is created or destroyed, in a way that stays faithful to the biology.",
          "expected_role": "method",
          "cue_keywords": [
            "what",
            "been",
