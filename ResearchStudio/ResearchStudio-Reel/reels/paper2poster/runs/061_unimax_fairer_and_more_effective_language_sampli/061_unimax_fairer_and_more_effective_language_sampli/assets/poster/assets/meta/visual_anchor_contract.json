      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_how_unimax_works_name_means",
          "text": "Here is how UniMax works. The name means uniform plus max. You start from a fixed character budget, C, and distribute it as uniformly as possible across the languages, processing them from lowest to highest resource.",
