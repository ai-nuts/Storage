    {
      "index": 4,
      "id": "contribution",
      "heading": "Contribution",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s04_c01",
          "anchor_id": "cue_s04_c1_sit_dataset_makes_several_contributi",
          "text": "The SiT dataset makes several contributions. It provides large-scale real-world pedestrian trajectories gathered as a robot navigated densely populated indoor and outdoor environments, from building interiors and campuses to crosswalks and public walkways.",
          "expected_role": "method",
          "cue_keywords": [
            "sit",
            "dataset",
            "makes",
            "several",
            "contributions",
            "provides",
            "large-scale",
            "real-world",
            "pedestrian",
            "trajectories"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_lets_researchers_build_prediction_mo",
          "text": "It lets researchers build prediction models using rich context, including appearance features, the robot's ego-motion, and semantic map data.",
          "expected_role": "content",
          "cue_keywords": [
            "lets",
            "researchers",
            "build",
            "prediction",
            "models",
            "rich",
            "context",
            "including",
            "appearance",
            "features"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s04_c03",
          "anchor_id": "cue_s04_c3_achieves_precise_time_synchronizatio",
          "text": "It achieves precise time synchronization between all sensor modalities using a centralized triggering method, which makes sensor fusion practical. It supplies multi-layered semantic maps for both indoor and outdoor scenes.",
          "expected_role": "method",
          "cue_keywords": [
            "achieves",
            "precise",
            "time",
            "synchronization",
            "between",
            "all",
            "sensor",
            "modalities",
            "centralized",
