        },
        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_popular_pedestrian_datasets_like_eth",
          "text": "Popular pedestrian datasets like ETH, UCY, and SDD were captured by fixed cameras mounted high on rooftops or drones, so they never see human-robot interaction.",
          "expected_role": "method",
          "cue_keywords": [
