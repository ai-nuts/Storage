      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s06_c01",
          "anchor_id": "cue_s06_c1_total_sit_contains_60_scenes",
          "text": "In total, SiT contains 60 scenes, which amounts to about sixty thousand images and twelve thousand point cloud frames, carrying roughly four hundred and seventy thousand two-dimensional annotations and three hundred and twenty thousand three-dimensional annotations.",
          "expected_role": "content",
          "cue_keywords": [
