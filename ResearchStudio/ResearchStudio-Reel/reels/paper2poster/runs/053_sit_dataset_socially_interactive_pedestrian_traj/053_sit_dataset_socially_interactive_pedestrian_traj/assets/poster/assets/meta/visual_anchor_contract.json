    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_captured_clearpath_husky_unmanned_gr",
          "text": "The data was captured with a Clearpath Husky unmanned ground vehicle, remotely operated through downtown Seoul. The robot carried two sixteen-channel Velodyne LiDARs, five Basler cameras arranged to cover a full 360 degrees, two inertial measurement units, and real-time kinematic positioning.",
          "expected_role": "content",
          "cue_keywords": [
            "captured",
            "clearpath",
            "husky",
            "unmanned",
            "ground",
            "vehicle",
            "remotely",
            "operated",
            "through",
            "downtown"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_fuse_camera_lidar_reliably_pulse_per",
          "text": "To fuse camera and LiDAR reliably, a pulse-per-second signal generator triggers all the sensors so their data is accurately aligned in time.",
          "expected_role": "content",
          "cue_keywords": [
            "fuse",
            "camera",
            "lidar",
            "reliably",
            "pulse-per-second",
            "signal",
            "generator",
            "triggers",
            "all",
            "sensors"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_robot_own_pose_recovered_rtk",
          "text": "The robot's own pose is recovered from RTK outdoors and from a LiDAR-inertial SLAM algorithm indoors, which is needed to compensate for the robot's ego-motion when forming pedestrian trajectories and to align the semantic maps.",
          "expected_role": "method",
          "cue_keywords": [
            "robot",
            "own",
            "pose",
            "recovered",
            "rtk",
            "outdoors",
            "lidar-inertial",
            "slam",
            "algorithm",
            "indoors"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s05_c04",
          "anchor_id": "cue_s05_c4_those_maps_twelve_layer_hierarchical",
          "text": "Those maps use a twelve-layer hierarchical structure built from point clouds and segmented by hand. Expert annotators labeled 3D cuboids at five hertz, which were interpolated up to ten hertz, and 2D boxes were generated from the 3D cuboids that share object IDs. For privacy, all faces and license plates are blurred.",
          "expected_role": "method",
          "cue_keywords": [
            "those",
            "maps",
            "twelve-layer",
            "hierarchical",
            "structure",
            "built",
            "point",
            "clouds",
            "segmented",
            "hand"
          ],
          "required": true
        }
      ]
