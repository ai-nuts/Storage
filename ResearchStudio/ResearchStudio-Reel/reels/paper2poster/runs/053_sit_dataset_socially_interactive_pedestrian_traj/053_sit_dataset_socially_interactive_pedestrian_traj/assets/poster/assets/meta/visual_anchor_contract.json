        {
          "chunk_index": 3,
          "chunk_id": "s06_c03",
          "anchor_id": "cue_s06_c3_three_d_pedestrian_detection_scored",
          "text": "Three-D pedestrian detection is scored with average precision based on center distance at thresholds of a quarter, a half, one, and two meters. Three-D tracking uses standard multi-object tracking metrics.",
          "expected_role": "method",
          "cue_keywords": [
            "three-d",
            "pedestrian",
