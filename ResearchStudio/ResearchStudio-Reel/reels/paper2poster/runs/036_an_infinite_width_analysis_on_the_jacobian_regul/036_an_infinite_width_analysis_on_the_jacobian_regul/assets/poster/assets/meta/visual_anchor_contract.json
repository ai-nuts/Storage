        {
          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_infinite_width_theory_built_tools_li",
          "text": "Infinite-width theory, built on tools like the Neural Tangent Kernel, has transformed how we understand deep network initialisation and training, but it has only ever described a network's output.",
          "expected_role": "method",
          "cue_keywords": [
            "infinite-width",
            "theory",
            "built",
            "tools",
            "like",
            "neural",
            "tangent",
            "kernel",
            "transformed",
            "how"
