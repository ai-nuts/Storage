        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_handle_joint_object_network_its",
          "text": "To handle the joint object, the network and its Jacobian together, the authors recast the convergence question as a tensor program and apply the Master theorem.",
          "expected_role": "title",
          "cue_keywords": [
            "handle",
