        {
          "chunk_index": 4,
          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_natural_question_left_wide_open",
          "text": "So a natural question is left wide open: can we extend infinite-width theory to the Jacobian itself, and to training that deliberately regularises it?",
          "expected_role": "method",
          "cue_keywords": [
