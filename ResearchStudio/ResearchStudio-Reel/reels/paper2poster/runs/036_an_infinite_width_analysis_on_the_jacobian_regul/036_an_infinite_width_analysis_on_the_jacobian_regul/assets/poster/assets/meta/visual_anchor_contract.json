    },
    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_over_last_few_years_infinite_width",
          "text": "Over the last few years, infinite-width theory has given us remarkably clean answers about deep networks. Tools like the Neural Tangent Kernel tell us how a network initialises, how it trains, and where gradient descent ends up.",
          "expected_role": "title",
          "cue_keywords": [
