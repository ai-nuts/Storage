          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_extends_theory_network_input_output",
          "text": "This paper extends that theory to the network's input-output Jacobian.",
          "expected_role": "content",
          "cue_keywords": [
            "extends",
            "theory",
            "network",
            "input-output",
            "jacobian"
