        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_they_define_finite_jntk_parameter_gr",
          "text": "They then define the finite JNTK from the parameter-gradients of both the output and each Jacobian component.",
          "expected_role": "content",
          "cue_keywords": [
            "they",
            "define",
            "finite",
            "jntk",
