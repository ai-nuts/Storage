          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s05_c03",
          "anchor_id": "cue_s05_c3_similarity_between_two_faces_dot",
          "text": "Similarity between two faces is the dot product of their masked, rectified embeddings, and the model predicts the odd-one-out probability directly from these three pairwise similarities.",
