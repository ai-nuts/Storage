    {
      "index": 5,
      "id": "method",
      "heading": "Method",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s05_c01",
          "anchor_id": "cue_s05_c1_recipe_three_moves_start_operation",
          "text": "Here is the recipe in three moves. Start from the operation set L-three: matrix product, transpose, the all-ones vector, diagonal, and element-wise product. Write down an exhaustive grammar whose sentences are exactly the fragment ML-of-L-three.",
          "expected_role": "content",
