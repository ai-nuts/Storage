      "heading": "Title",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s01_c01",
          "anchor_id": "cue_s01_c1_introduces_first_order_repulsive_dee",
          "text": "This paper introduces First-order Repulsive Deep Ensembles, or FoRDE, a new way to train neural network ensembles.",
          "expected_role": "content",
          "cue_keywords": [
            "introduces",
            "first-order",
            "repulsive",
            "deep",
            "ensembles",
            "forde",
            "new",
            "way",
            "train",
            "neural"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s01_c02",
          "anchor_id": "cue_s01_c2_deep_ensembles_work_well_because",
          "text": "Deep ensembles work well because their members learn diverse functions, but existing methods that repel members in weight space or function space have struggled to improve on plain deep ensembles. The key idea here is to instead repel ensemble members in the space of their input gradients.",
          "expected_role": "method",
          "cue_keywords": [
            "deep",
            "ensembles",
            "work",
            "well",
            "because",
            "their",
            "members",
            "learn",
            "diverse",
            "functions"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s01_c03",
          "anchor_id": "cue_s01_c3_because_input_gradients_uniquely_cha",
          "text": "Because input gradients uniquely characterize a function up to translation and are far smaller than the weights, this guarantees members become functionally different and encourages each network to learn distinct features.",
          "expected_role": "content",
          "cue_keywords": [
            "because",
            "input",
            "gradients",
            "uniquely",
            "characterize",
            "function",
            "translation",
            "far",
            "smaller",
            "weights"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s01_c04",
          "anchor_id": "cue_s01_c4_result_ensemble_markedly_more_robust",
          "text": "The result is an ensemble that is markedly more robust and better calibrated under input corruptions.",
          "expected_role": "result",
          "cue_keywords": [
            "result",
            "ensemble",
            "markedly",
            "more",
            "robust",
            "better",
            "calibrated",
            "under",
            "input",
            "corruptions"
          ],
          "required": true
        }
      ]
    },
    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_ensembles_neural_networks_powerful_b",
          "text": "Ensembles of neural networks are powerful because different members capture different explanations of the data. Particle-based variational inference tries to make this diversity explicit by adding a repulsion term that pushes members apart. But where you apply that repulsion matters.",
          "expected_role": "guidance",
          "cue_keywords": [
            "ensembles",
            "neural",
            "networks",
            "powerful",
            "because",
            "different",
            "members",
            "capture",
            "different",
            "explanations"
          ],
          "required": true
        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_repelling_weight_space_wasteful_beca",
          "text": "Repelling in weight space is wasteful, because neural networks are heavily over-parameterized and many different weights encode the same function.",
          "expected_role": "content",
          "cue_keywords": [
            "repelling",
            "weight",
            "space",
            "wasteful",
            "because",
            "neural",
            "networks",
            "heavily",
            "over-parameterized",
            "many"
          ],
          "required": true
        },
        {
          "chunk_index": 3,
          "chunk_id": "s02_c03",
          "anchor_id": "cue_s02_c3_repelling_directly_function_space_so",
          "text": "Repelling directly in function space sounds appealing, but it requires comparing entire functions, which is computationally hard, and the shortcuts used in prior work led to underfitting.",
          "expected_role": "method",
          "cue_keywords": [
            "repelling",
            "directly",
            "function",
            "space",
            "sounds",
            "appealing",
            "but",
            "requires",
            "comparing",
            "entire"
          ],
          "required": true
        },
        {
          "chunk_index": 4,
          "chunk_id": "s02_c04",
          "anchor_id": "cue_s02_c4_neither_weight_space_nor_function_sp",
          "text": "So neither weight-space nor function-space repulsion had delivered meaningful gains over standard deep ensembles.",
          "expected_role": "result",
          "cue_keywords": [
            "neither",
            "weight-space",
            "nor",
            "function-space",
            "repulsion",
            "had",
            "delivered",
            "meaningful",
            "gains",
            "over"
          ],
          "required": true
