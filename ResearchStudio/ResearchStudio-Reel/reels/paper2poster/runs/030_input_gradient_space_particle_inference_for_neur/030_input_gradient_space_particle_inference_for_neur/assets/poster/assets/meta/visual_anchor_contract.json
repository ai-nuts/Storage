        },
        {
          "chunk_index": 2,
          "chunk_id": "s04_c02",
          "anchor_id": "cue_s04_c2_first_introduces_first_order_repulsi",
          "text": "First, it introduces First-order Repulsive Deep Ensembles, a method that adds a repulsion term defined on input gradients rather than weights or function outputs.",
          "expected_role": "method",
