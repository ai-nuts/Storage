        },
        {
          "chunk_index": 2,
          "chunk_id": "s02_c02",
          "anchor_id": "cue_s02_c2_but_long_standing_empirical_observat",
          "text": "But a long-standing empirical observation is that they falter when the data has long-term dependencies.",
          "expected_role": "content",
          "cue_keywords": [
            "but",
            "long-standing",
            "empirical",
            "observation",
            "they",
            "falter",
            "when",
            "long-term",
            "dependencies"
