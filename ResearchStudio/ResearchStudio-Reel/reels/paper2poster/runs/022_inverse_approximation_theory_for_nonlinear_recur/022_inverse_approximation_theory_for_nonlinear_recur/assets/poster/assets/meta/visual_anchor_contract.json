        {
          "chunk_index": 4,
          "chunk_id": "s04_c04",
          "anchor_id": "cue_s04_c4_top_theory_proposes_principled_repar",
          "text": "On top of the theory, it proposes a principled reparameterization method to overcome the identified limitation and confirms the whole story with experiments.",
          "expected_role": "method",
          "cue_keywords": [
            "top",
            "theory",
            "proposes",
            "principled",
            "reparameterization",
            "method",
