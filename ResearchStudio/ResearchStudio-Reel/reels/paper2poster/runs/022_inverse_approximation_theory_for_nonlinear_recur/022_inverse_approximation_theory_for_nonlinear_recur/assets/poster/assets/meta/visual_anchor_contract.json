        }
      ]
    },
    {
      "index": 2,
      "id": "problem",
      "heading": "Problem",
      "chunks": [
        {
          "chunk_index": 1,
          "chunk_id": "s02_c01",
          "anchor_id": "cue_s02_c1_recurrent_neural_networks_among_most",
          "text": "Recurrent neural networks are among the most basic models for learning from sequential and temporal data, with applications from time series and speech to text and sentiment.",
          "expected_role": "content",
          "cue_keywords": [
            "recurrent",
            "neural",
            "networks",
            "among",
            "most",
            "basic",
            "models",
            "learning",
            "sequential",
