        {
          "chunk_index": 2,
          "chunk_id": "s05_c02",
          "anchor_id": "cue_s05_c2_two_projectors_normalized_combined_m",
          "text": "The two projectors are normalized and combined into a modified direction R, so when a batch is mostly genuine the update leans toward preserving old knowledge, and otherwise it leans toward learning the new data.",
          "expected_role": "content",
          "cue_keywords": [
            "two",
            "projectors",
            "normalized",
            "combined",
            "modified",
            "direction",
            "when",
            "batch",
            "mostly",
            "genuine"
